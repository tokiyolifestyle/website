<div class="customer-page page-width">
  <div class="customer-page__card">

    <div class="customer-page__logo">
      <a href="{{ routes.root_url }}">
        <img src="{{ 'tokiyo-logo.jpeg' | asset_url }}" alt="{{ shop.name }}" width="150" height="auto" loading="eager" class="customer-logo-img">
      </a>
    </div>

    <h1 class="customer-page__title">Create Account</h1>
    <p class="customer-page__subtitle">Join Tokiyo Lifestyle for exclusive VIP rewards & fast checkout</p>

    {%- form 'create_customer' -%}
      {%- if form.errors -%}
        <div class="form-errors">{{ form.errors | default_errors }}</div>
      {%- endif -%}

      <div class="form-row">
        <div class="form-field">
          <label for="FirstName">First Name</label>
          <input type="text" name="customer[first_name]" id="FirstName" autocomplete="given-name" placeholder="John">
        </div>
        <div class="form-field">
          <label for="LastName">Last Name</label>
          <input type="text" name="customer[last_name]" id="LastName" autocomplete="family-name" placeholder="Doe">
        </div>
      </div>

      <div class="form-field">
        <label for="RegisterEmail">Email Address</label>
        <input type="email" name="customer[email]" id="RegisterEmail" autocomplete="email" placeholder="your@email.com" required>
      </div>

      <div class="form-field">
        <label for="RegisterPassword">Password</label>
        <input type="password" name="customer[password]" id="RegisterPassword" autocomplete="new-password" placeholder="••••••••" required>
      </div>

      <button type="submit" class="button button--solid button--full customer-page__btn">Create Account</button>
    {%- endform -%}

    <div class="customer-page__footer-link">
      Already have an account? <a href="{{ routes.account_login_url }}">Sign in here</a>
    </div>
  </div>
</div>
