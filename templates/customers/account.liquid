<div class="account-dashboard page-width">

  {%- comment -%} Header & Welcome Banner {%- endcomment -%}
  <div class="account-dashboard__hero">
    <div class="account-dashboard__welcome">
      <div class="account-dashboard__avatar">
        {{ customer.first_name | slice: 0 | default: 'T' | upcase }}
      </div>
      <div>
        <h1 class="account-dashboard__name">Welcome, {{ customer.first_name | default: 'Member' }} 👋</h1>
        <p class="account-dashboard__email">{{ customer.email }}</p>
      </div>
    </div>
    <div class="account-dashboard__hero-actions">
      <a href="{{ routes.account_addresses_url }}" class="button button--outline button--small">Saved Addresses ({{ customer.addresses_count }})</a>
      <a href="{{ routes.account_logout_url }}" class="button button--solid button--small account-logout-btn">Log Out</a>
    </div>
  </div>

  <div class="account-dashboard__grid">

    {%- comment -%} Left Column: VIP Privilege Card & Tier Benefits {%- endcomment -%}
    <div class="account-dashboard__col-left">

      {%- comment -%} TOKIYO PRIVILEGE VIP CARD {%- endcomment -%}
      {%- assign base_timestamp = 'now' | date: '%s' | plus: 0 -%}
      {%- if customer.orders.size > 0 -%}
        {%- assign latest_order_date = customer.orders.first.created_at | date: '%s' | plus: 0 -%}
        {%- assign base_timestamp = latest_order_date -%}
      {%- endif -%}
      {%- assign validity_seconds = 90 | times: 24 | times: 60 | times: 60 -%}
      {%- assign validity_timestamp = base_timestamp | plus: validity_seconds -%}
      {%- assign card_number_seed = customer.id | default: 94819 -%}
      {%- assign card_number_part1 = card_number_seed | modulo: 10000 -%}
      {%- assign card_number_part2 = card_number_seed | divided_by: 10 | modulo: 10000 -%}

      <div class="account-card-wrap">
        <h2 class="account-section-title">My VIP Privilege Card</h2>

        <div class="tokiyo-vip-card">
          <!-- Glass Reflection Effects -->
          <div class="vip-card__glow-red"></div>
          <div class="vip-card__glow-gold"></div>

          <!-- Top Row -->
          <div class="vip-card__header">
            <div class="vip-card__brand">
              <img src="{{ 'tokiyo-logo.jpeg' | asset_url }}" alt="Tokiyo Lifestyle" class="vip-card__logo-img">
              <span class="vip-card__brand-sub">VIP MEMBER</span>
            </div>
            <span class="vip-card__badge">BLACK TIER</span>
          </div>

          <!-- Chip & Contactless -->
          <div class="vip-card__chip-row">
            <div class="vip-card__chip">
              <div class="vip-card__chip-inner"></div>
            </div>
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,0.4)" stroke-width="2" stroke-linecap="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </div>

          <!-- Card Number -->
          <div class="vip-card__number">
            TK-{{ card_number_part1 | default: '4820' | prepend: '0000' | slice: -4, 4 }}-{{ card_number_part2 | default: '9284' | prepend: '0000' | slice: -4, 4 }}
          </div>

          <!-- Footer Info -->
          <div class="vip-card__footer">
            <div>
              <span class="vip-card__label">MEMBER NAME</span>
              <span class="vip-card__val">{{ customer.name | default: 'VIP Guest' }}</span>
            </div>
            <div class="text-right">
              <span class="vip-card__label">VALID UNTIL</span>
              <span class="vip-card__val font-mono">{{ validity_timestamp | date: '%d/%m/%Y' }}</span>
            </div>
          </div>
        </div>

        <!-- VIP Benefits Badge -->
        <div class="vip-benefits-box">
          <div class="vip-benefit-item">
            <span class="vip-benefit-icon">⚡</span>
            <div>
              <strong>Validity Extension:</strong> Extended by +3 months on every purchase automatically!
            </div>
          </div>
          <div class="vip-benefit-item">
            <span class="vip-benefit-icon">👑</span>
            <div>
              <strong>VIP Privileges:</strong> Priority dispatch, free size exchange & early access to new collection drops.
            </div>
          </div>
        </div>
      </div>

    </div>

    {%- comment -%} Right Column: Orders & Account Details {%- endcomment -%}
    <div class="account-dashboard__col-right">

      <h2 class="account-section-title">Order History</h2>

      {%- if customer.orders.size > 0 -%}
        <div class="account-orders-list">
          {%- for order in customer.orders -%}
            <div class="account-order-card">
              <div class="account-order-card__header">
                <div>
                  <a href="{{ order.customer_url }}" class="account-order-card__name">{{ order.name }}</a>
                  <span class="account-order-card__date">{{ order.created_at | date: '%b %d, %Y' }}</span>
                </div>
                <div class="account-order-card__status">
                  <span class="status-badge status-badge--{{ order.financial_status }}">{{ order.financial_status_label }}</span>
                  <span class="status-badge status-badge--{{ order.fulfillment_status }}">{{ order.fulfillment_status_label }}</span>
                </div>
              </div>
              <div class="account-order-card__footer">
                <span class="account-order-card__total">Total: <strong>{{ order.total_price | money }}</strong> ({{ order.item_count }} item{% if order.item_count > 1 %}s{% endif %})</span>
                <a href="{{ order.customer_url }}" class="button button--outline button--small">View Order →</a>
              </div>
            </div>
          {%- endfor -%}
        </div>
      {%- else -%}
        <div class="account-empty-orders">
          <div class="account-empty-icon">🛍️</div>
          <h3>No Orders Yet</h3>
          <p>You haven't placed any orders yet. Start exploring our oversized streetwear collections!</p>
          <a href="/collections/all" class="button button--solid">Explore Collections</a>
        </div>
      {%- endif -%}

    </div>

  </div>

</div>
