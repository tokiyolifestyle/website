{%- comment -%}
  Product card snippet — Dark Premium
  Accepts: product, section (optional), lazy (optional, default: true), class_modifier
{%- endcomment -%}

{%- assign loading_attr = 'lazy' -%}
{%- if lazy == false -%}{%- assign loading_attr = 'eager' -%}{%- endif -%}
{%- assign card_class = 'product-card' -%}
{%- if class_modifier != blank -%}{%- assign card_class = card_class | append: ' ' | append: class_modifier -%}{%- endif -%}

{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- assign is_on_sale = false -%}
{%- if current_variant.compare_at_price > current_variant.price -%}{%- assign is_on_sale = true -%}{%- endif -%}
{%- assign save_percent = current_variant.compare_at_price | minus: current_variant.price | times: 100 | divided_by: current_variant.compare_at_price -%}

<div class="{{ card_class }}" data-product-id="{{ product.id }}">
  <a href="{{ product.url }}" class="product-card__link" aria-label="{{ product.title | escape }}">
    <div class="product-card__media{% if settings.card_image_ratio == 'square' %} is-square{% endif %}">

      {%- assign card_media = current_variant.featured_media | default: product.featured_media -%}
      {%- if card_media -%}
        {{ card_media | image_url: width: 600 | image_tag:
          loading: loading_attr,
          widths: '300, 400, 600',
          sizes: '(max-width:749px) 50vw, 25vw',
          class: 'product-card__image product-card__image--primary',
          alt: card_media.alt | default: product.title | escape
        }}
        {%- if settings.show_secondary_image and product.images.size > 1 -%}
          {%- assign sec_image = nil -%}
          {%- for img in product.images -%}
            {%- assign img_alt_dn = img.alt | downcase -%}
            {%- assign img_src_dn = img.src | downcase -%}
            {%- unless img.id == card_media.id or img_alt_dn contains 'size-guide' or img_alt_dn contains 'size chart' or img_alt_dn contains 'sizeguide' or img_src_dn contains 'size-guide' or img_src_dn contains 'size-chart' -%}
              {%- assign sec_image = img -%}
              {%- break -%}
            {%- endunless -%}
          {%- endfor -%}
          {%- if sec_image != blank -%}
            {{ sec_image | image_url: width: 600 | image_tag:
              loading: 'lazy',
              widths: '300, 400, 600',
              sizes: '(max-width:749px) 50vw, 25vw',
              class: 'product-card__image product-card__image--secondary',
              alt: sec_image.alt | default: product.title | escape
            }}
          {%- endif -%}
        {%- endif -%}
      {%- else -%}
        <div class="coming-soon-placeholder">
          <div class="coming-soon-placeholder__inner">
            <span class="coming-soon-placeholder__icon">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>
            </span>
            <span class="coming-soon-placeholder__text">Coming Soon</span>
          </div>
        </div>
      {%- endif -%}

      <div class="product-card__badges">
        {%- if product.available == false -%}
          <span class="badge badge--soldout">Sold Out</span>
        {%- elsif is_on_sale -%}
          <span class="badge badge--sale">-{{ save_percent }}%</span>
        {%- elsif product.tags contains 'new' or product.tags contains 'New Arrival' -%}
          <span class="badge badge--new">New</span>
        {%- endif -%}
      </div>

      {%- comment -%} Live Viewers Indicator — shows on hover {%- endcomment -%}
      <div class="product-card__live-viewers" aria-hidden="true">
        <span class="live-dot"></span>
        <span class="live-text"><span class="live-count"></span> people viewing</span>
      </div>      {%- if settings.enable_wishlist -%}
        <button
          class="product-card__wishlist-btn"
          data-wishlist-toggle="{{ product.id }}"
          aria-label="Add to Wishlist"
          type="button">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
        </button>
      {%- endif -%}

      <button
        class="product-card__share-btn"
        data-share-product="{{ shop.url }}{{ product.url }}"
        data-share-title="{{ product.title | escape }}"
        aria-label="Share product"
        type="button">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
      </button>

      {%- if product.available -%}
        <div class="product-card__quick-add">
          <button
            class="button button--solid button--full button--small product-card__add-btn"
            data-quick-add-trigger
            data-product-id="{{ product.id }}"
            data-product-title="{{ product.title | escape }}"
            data-product-price="{{ current_variant.price | money }}"
            data-product-compare="{{ current_variant.compare_at_price | money }}"
            data-product-image="{{ card_media | image_url: width: 500 }}"
            data-has-only-default="{{ product.has_only_default_variant }}"
            data-default-variant-id="{{ product.variants.first.id }}"
            type="button">
            🛒 Add to Cart
          </button>
          <script type="application/json" class="product-variants-json">
            [
              {%- for variant in product.variants -%}
                {
                  "id": {{ variant.id }},
                  "title": {{ variant.title | json }},
                  "option1": {{ variant.option1 | json }},
                  "option2": {{ variant.option2 | json }},
                  "price": {{ variant.price | json }},
                  "compare_at_price": {{ variant.compare_at_price | json }},
                  "available": {{ variant.available | json }}
                }{%- unless forloop.last -%},{%- endunless -%}
              {%- endfor -%}
            ]
          </script>
        </div>
      {%- endif -%}
    </div>
  </a>

  <div class="product-card__info">
    {%- if settings.show_vendor -%}
      {%- assign display_vendor = product.vendor -%}
      {%- if display_vendor == blank or display_vendor contains 'tokiyo' or display_vendor contains 'theme' or display_vendor contains 'shopify' -%}
        {%- assign display_vendor = 'TOKIYO LIFESTYLE' -%}
      {%- endif -%}
      <p class="product-card__vendor">{{ display_vendor }}</p>
    {%- endif -%}
    <h3 class="product-card__title">
      <a href="{{ product.url }}">{{ product.title }}</a>
    </h3>
    <div class="product-card__price">
      {%- if is_on_sale -%}
        <span class="price--sale">{{ current_variant.price | money }}</span>
        <span class="price--compare">{{ current_variant.compare_at_price | money }}</span>
      {%- else -%}
        <span>{{ current_variant.price | money }}</span>
      {%- endif -%}
    </div>

    {%- comment -%} Star Ratings {%- endcomment -%}
    <div class="product-card__rating">
      <div class="product-card__stars">
        {%- for i in (1..5) -%}
          <svg viewBox="0 0 20 20"><path d="M10 1l2.39 6.56H19l-5.3 4.04 1.97 6.56L10 14.24l-5.67 3.92 1.97-6.56L1 7.56h6.61z"/></svg>
        {%- endfor -%}
      </div>
      <span class="product-card__rating-count">4.8</span>
    </div>

    {%- assign color_option = product.options_by_name['Color'] -%}
    {%- if color_option != blank and color_option.values.size > 1 -%}
      <div class="product-card__swatches" aria-label="Colors">
        {%- for value in color_option.values limit: 4 -%}
          {%- assign hex_color = value | handle | replace: '-', '' -%}
          {%- assign check_val = value | downcase -%}
          {%- if check_val == 'white' -%}{%- assign hex_color = '#FFFFFF' -%}
          {%- elsif check_val == 'beige' -%}{%- assign hex_color = '#E4D5B7' -%}
          {%- elsif check_val == 'pista' -%}{%- assign hex_color = '#C1F8C2' -%}
          {%- elsif check_val == 'airforce' or check_val == 'air force' -%}{%- assign hex_color = '#5F8A96' -%}
          {%- elsif check_val == 'peach' -%}{%- assign hex_color = '#FFE5B4' -%}
          {%- elsif check_val == 'lavender' -%}{%- assign hex_color = '#E6E6FA' -%}
          {%- elsif check_val == 'mustard' -%}{%- assign hex_color = '#E1AD01' -%}
          {%- elsif check_val == 'onion pink' or check_val == 'onion-pink' -%}{%- assign hex_color = '#D1A3A4' -%}
          {%- elsif check_val == 'wine' -%}{%- assign hex_color = '#722F37' -%}
          {%- elsif check_val == 'd. grey' or check_val == 'd-grey' or check_val == 'dark grey' or check_val == 'dark-grey' -%}{%- assign hex_color = '#5A5A5A' -%}
          {%- elsif check_val == 'black' -%}{%- assign hex_color = '#111111' -%}
          {%- endif -%}
          <span class="swatch" style="background-color:{{ hex_color }}; border: 1px solid rgba(0,0,0,0.12);" title="{{ value }}"></span>
        {%- endfor -%}
        {%- if color_option.values.size > 4 -%}
          <span class="swatch--more">+{{ color_option.values.size | minus: 4 }}</span>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>
