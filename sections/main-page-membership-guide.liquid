{%- comment -%} Tokiyo Lifestyle — Membership & Benefits Guide Section {%- endcomment -%}

<div class="membership-guide-page page-width">
  
  <!-- Hero Section -->
  <div class="mg-hero animate-on-scroll fade-up">
    <span class="mg-eyebrow">👑 TOKIYO VIP PRIVILEGE SYSTEM</span>
    <h1 class="mg-title">Tokiyo VIP Membership Guide</h1>
    <p class="mg-subtitle">
      Wear Tokiyo Lifestyle, unlock exclusive partner perks, get <strong>5% OFF</strong> at local cafes, restaurants, gyms & spots across your city, and extend your membership with every purchase or referral!
    </p>
  </div>

  <!-- Membership Validity Matrix -->
  <div class="mg-matrix-section animate-on-scroll fade-up">
    <h2 class="mg-section-title">How To Earn & Extend Tokiyo VIP Membership</h2>
    <div class="mg-matrix-grid">
      
      <div class="mg-card mg-card--featured">
        <div class="mg-card__badge">LIMITED OFFER</div>
        <div class="mg-card__icon">🎁</div>
        <h3>First 1,000 Customers</h3>
        <div class="mg-card__val">6 Months Free</div>
        <p>Get 6 full months of Tokiyo VIP Membership automatically bundled with your very first purchase!</p>
      </div>

      <div class="mg-card">
        <div class="mg-card__icon">🛍️</div>
        <h3>Every Next Purchase</h3>
        <div class="mg-card__val">+2 Months</div>
        <p>Every subsequent order automatically adds +2 months extension to your active membership expiry date.</p>
      </div>

      <div class="mg-card">
        <div class="mg-card__icon">⚡</div>
        <h3>New Registration</h3>
        <div class="mg-card__val">15 Days Free Trial</div>
        <p>Register an account on Tokiyo Lifestyle and instantly get 15 days free trial membership—no purchase required!</p>
      </div>

      <div class="mg-card">
        <div class="mg-card__icon">👥</div>
        <h3>Successful Referral</h3>
        <div class="mg-card__val">+10 Days</div>
        <p>Refer friends to Tokiyo Lifestyle. For every friend who completes their first order, you get +10 days bonus!</p>
      </div>

    </div>
  </div>

  <!-- How a Customer Avails Discount (3-Step Guide) -->
  <div class="mg-steps-section animate-on-scroll fade-up">
    <h2 class="mg-section-title">3 Steps To Claim Your 5% Partner Discount</h2>
    
    <div class="mg-steps-grid">
      <div class="mg-step-card">
        <div class="step-num">01</div>
        <h3>Become a Tokiyo Member</h3>
        <p>Sign in to your account to access your unique <strong>Tokiyo Member Pass</strong>, Member ID (e.g. <code>TKL000123</code>), Active Status & QR Code.</p>
      </div>

      <div class="mg-step-card">
        <div class="step-num">02</div>
        <h3>Visit a Partner Spot</h3>
        <p>Open <a href="/pages/tokiyo-near-you" style="color: var(--color-accent, #ff0000); font-weight: 700;">Tokiyo Near You</a> to discover participating cafes, restaurants, gyms & stores in your locality (e.g., Patia, Bhubaneswar).</p>
      </div>

      <div class="mg-step-card">
        <div class="step-num">03</div>
        <h3>Verify & Claim Discount</h3>
        <p>At billing checkout, show your Tokiyo Digital Pass or wear your Tokiyo Tee. The partner verifies your status and applies <strong>5% OFF</strong> instantly!</p>
      </div>
    </div>
  </div>

  <!-- Member Benefits Overview -->
  <div class="mg-benefits-box animate-on-scroll fade-up">
    <h2>VIP Privilege Card Benefits</h2>
    <ul class="mg-benefits-list">
      <li><strong>⚡ 5% Off at Partner Spots:</strong> Claim 5% discount on food, beverages, fitness passes, salon services & shopping at participating local partners.</li>
      <li><strong>🚚 Priority Dispatch & Size Exchange:</strong> VIP members get expedited order processing and 100% free size exchanges on all apparel.</li>
      <li><strong>🔥 Early Access to Drops:</strong> Unlock 24-hour early access preview for limited edition Anime & Streetwear collections before public release.</li>
      <li><strong>💬 VIP WhatsApp Support:</strong> Direct 1-on-1 priority WhatsApp support for instant size guidance and order assistance.</li>
    </ul>
  </div>

  <!-- Terms & Conditions Accordions -->
  <div class="mg-terms-section animate-on-scroll fade-up">
    <h2 class="mg-section-title">Tokiyo Membership Terms & Conditions</h2>
    
    <div class="mg-terms-box">
      <h3>Customer Terms & Conditions</h3>
      <ol class="terms-list">
        <li><strong>Membership Eligibility:</strong> Tokiyo partner benefits are available exclusively to users with an active, unexpired Tokiyo VIP Membership.</li>
        <li><strong>Verification:</strong> Customers must present their valid digital Tokiyo Member Pass, QR code, or wear authentic Tokiyo apparel at participating locations.</li>
        <li><strong>Standard Discount:</strong> The standard partner discount is 5% OFF on eligible transactions, unless a custom offer is specified by the partner.</li>
        <li><strong>Usage Limit:</strong> Discounts apply once per transaction and cannot be transferred or sold to another individual.</li>
        <li><strong>Combination of Offers:</strong> Tokiyo benefits cannot be combined with existing clearance sales or special promotional menus unless explicitly allowed by the partner.</li>
        <li><strong>Referral Abuse Protection:</strong> Referral bonus days (+10 days) are granted only when the referred user completes a verified purchase to prevent duplicate trial accounts.</li>
      </ol>
    </div>
  </div>

</div>

<style>
  .membership-guide-page {
    padding-block: 3.5rem 5rem;
    max-width: 1000px;
    margin-inline: auto;
  }
  .mg-hero {
    text-align: center;
    margin-bottom: 3.5rem;
  }
  .mg-eyebrow {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    color: var(--color-accent, #ff0000);
    background: rgba(255, 0, 0, 0.08);
    padding: 0.35rem 1rem;
    border-radius: 50px;
    margin-bottom: 0.75rem;
  }
  .mg-title {
    font-family: 'Outfit', sans-serif;
    font-size: clamp(2.2rem, 4vw, 3.2rem);
    font-weight: 900;
    color: #111111;
    margin-bottom: 0.85rem;
    line-height: 1.15;
  }
  .mg-subtitle {
    font-size: 1.05rem;
    color: #555555;
    max-width: 720px;
    margin-inline: auto;
    line-height: 1.6;
  }

  .mg-section-title {
    font-size: 1.5rem;
    font-weight: 800;
    color: #111111;
    text-align: center;
    margin-bottom: 2.25rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  /* Matrix Grid */
  .mg-matrix-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
    margin-bottom: 4rem;
  }
  @media(max-width: 989px) { .mg-matrix-grid { grid-template-columns: repeat(2, 1fr); } }
  @media(max-width: 549px) { .mg-matrix-grid { grid-template-columns: 1fr; } }

  .mg-card {
    background: #FFFFFF;
    border: 1px solid rgba(0,0,0,0.08);
    box-shadow: 0 10px 30px rgba(0,0,0,0.04);
    border-radius: 16px;
    padding: 1.75rem 1.25rem;
    text-align: center;
    position: relative;
    display: flex;
    flex-direction: column;
  }
  .mg-card--featured {
    border-color: #111111;
    box-shadow: 0 12px 35px rgba(0,0,0,0.1);
  }
  .mg-card__badge {
    position: absolute;
    top: -10px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--color-accent, #ff0000);
    color: #FFFFFF;
    font-size: 0.6rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    padding: 0.25rem 0.65rem;
    border-radius: 50px;
  }
  .mg-card__icon { font-size: 2.2rem; margin-bottom: 0.75rem; }
  .mg-card h3 { font-size: 0.95rem; font-weight: 800; color: #111111; margin-bottom: 0.35rem; }
  .mg-card__val { font-size: 1.2rem; font-weight: 900; color: var(--color-accent, #ff0000); margin-bottom: 0.65rem; }
  .mg-card p { font-size: 0.82rem; color: #666666; line-height: 1.5; margin: 0; }

  /* Steps Grid */
  .mg-steps-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-bottom: 4rem;
  }
  @media(max-width: 749px) { .mg-steps-grid { grid-template-columns: 1fr; } }
  
  .mg-step-card {
    background: #F9F9FB;
    border: 1px solid rgba(0,0,0,0.06);
    border-radius: 16px;
    padding: 2rem 1.5rem;
    position: relative;
  }
  .step-num {
    font-family: 'Outfit', sans-serif;
    font-size: 2.5rem;
    font-weight: 900;
    color: rgba(0,0,0,0.1);
    position: absolute;
    top: 15px;
    right: 20px;
  }
  .mg-step-card h3 { font-size: 1.1rem; font-weight: 800; color: #111111; margin-bottom: 0.65rem; }
  .mg-step-card p { font-size: 0.88rem; color: #555555; line-height: 1.55; margin: 0; }

  /* Benefits Box */
  .mg-benefits-box {
    background: #111111;
    color: #FFFFFF;
    border-radius: 20px;
    padding: 2.5rem;
    margin-bottom: 4rem;
  }
  .mg-benefits-box h2 { font-size: 1.4rem; font-weight: 800; margin-bottom: 1.5rem; letter-spacing: 0.04em; }
  .mg-benefits-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 1rem; }
  .mg-benefits-list li { font-size: 0.92rem; color: rgba(255,255,255,0.85); line-height: 1.6; }
  .mg-benefits-list strong { color: #FFFFFF; }

  /* Terms Box */
  .mg-terms-box {
    background: #FFFFFF;
    border: 1px solid rgba(0,0,0,0.08);
    border-radius: 16px;
    padding: 2rem;
  }
  .mg-terms-box h3 { font-size: 1.1rem; font-weight: 800; color: #111111; margin-bottom: 1rem; }
  .terms-list { padding-left: 1.25rem; margin: 0; color: #555555; font-size: 0.88rem; line-height: 1.65; }
  .terms-list li { margin-bottom: 0.75rem; }
</style>
