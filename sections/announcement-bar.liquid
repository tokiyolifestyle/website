{%- comment -%} Announcement Bar — Auto-scroll Marquee {%- endcomment -%}

<div class="announcement-bar" data-announcement-bar>
  <div class="announcement-bar__track" style="animation-duration: {{ section.settings.speed | default: 75 }}s;">
    {%- for block in section.blocks -%}
      {%- for i in (1..2) -%}
        <div class="announcement-bar__item" {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}">✦&nbsp;&nbsp;{{ block.settings.text }}&nbsp;&nbsp;✦</a>
          {%- else -%}
            <p>✦&nbsp;&nbsp;{{ block.settings.text }}&nbsp;&nbsp;✦</p>
          {%- endif -%}
        </div>
      {%- endfor -%}
    {%- endfor -%}
    {%- comment -%} Hardcoded Promo Slide {%- endcomment -%}
    {%- for i in (1..2) -%}
      <div class="announcement-bar__item">
        <p>✦&nbsp;&nbsp;USE CODE: TOKIYO10 FOR 10% OFF YOUR FIRST ORDER&nbsp;&nbsp;✦</p>
      </div>
    {%- endfor -%}
    
    {%- comment -%} Duplicate for seamless loop {%- endcomment -%}
    {%- for block in section.blocks -%}
      {%- for i in (1..2) -%}
        <div class="announcement-bar__item" aria-hidden="true">
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}">✦&nbsp;&nbsp;{{ block.settings.text }}&nbsp;&nbsp;✦</a>
          {%- else -%}
            <p>✦&nbsp;&nbsp;{{ block.settings.text }}&nbsp;&nbsp;✦</p>
          {%- endif -%}
        </div>
      {%- endfor -%}
    {%- endfor -%}
    {%- for i in (1..2) -%}
      <div class="announcement-bar__item" aria-hidden="true">
        <p>✦&nbsp;&nbsp;USE CODE: TOKIYO10 FOR 10% OFF YOUR FIRST ORDER&nbsp;&nbsp;✦</p>
      </div>
    {%- endfor -%}
  </div>
</div>

<style>
  .announcement-bar {
    background: #111111 !important;
    display: block;
    overflow: hidden;
    padding: 0.65rem 0;
    margin: 0;
    line-height: 1;
    position: relative;
    border-bottom: 1px solid rgba(255,255,255,0.08);
  }
  .announcement-bar a,
  .announcement-bar__item,
  .announcement-bar__item p {
    color: #FFFFFF !important;
    text-decoration: none;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-size: 0.78rem;
    text-shadow: none !important;
  }
  .announcement-bar__track {
    display: flex;
    white-space: nowrap;
    animation: announcement-scroll linear infinite;
    width: max-content;
  }
  .announcement-bar__item {
    padding: 0 2rem;
    flex-shrink: 0;
  }
  .announcement-bar__item p {
    margin: 0;
  }
  @keyframes announcement-scroll {
    0% { transform: translate3d(0, 0, 0); }
    100% { transform: translate3d(-50%, 0, 0); }
  }
</style>

{% schema %}
{
  "name": "Announcement Bar",
  "tag": "section",
  "class": "section-announcement",
  "settings": [
    {
      "type": "range",
      "id": "speed",
      "min": 20,
      "max": 120,
      "step": 5,
      "unit": "s",
      "label": "Scroll speed",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Free shipping on Prepaid Orders (₹1199 for COD)" },
        { "type": "url", "id": "link", "label": "Link (optional)" }
      ]
    }
  ]
}
{% endschema %}
