<div class="search-drawer-overlay overlay" data-search-overlay></div>
<div class="search-drawer" data-search-drawer id="SearchDrawer" role="dialog" aria-modal="true" aria-label="Search">
  <div class="search-drawer__header">
    <h2 class="search-drawer__title">Search Products</h2>
    <button type="button" class="search-drawer__close" data-search-close aria-label="Close">{% render 'icon-close' %}</button>
  </div>
  <div class="search-drawer__form-wrap">
    <form action="{{ routes.search_url }}" method="get" role="search">
      <input type="hidden" name="type" value="product">
      <div class="search-drawer__input-wrap">
        <span class="search-drawer__icon">{% render 'icon-search' %}</span>
        <input type="search" name="q" id="SearchDrawerInput" class="search-drawer__input" data-search-input placeholder="{{ 'general.search.placeholder' | t | default: 'Search hoodies, cargo pants, oversized tees...' }}" aria-label="Search" autocomplete="off">
        <button type="submit" class="search-drawer__submit" aria-label="Search">{% render 'icon-chevron-right' %}</button>
      </div>
    </form>
  </div>
  <div class="search-drawer__suggestions">
    <p class="search-drawer__suggestions-label">Popular searches</p>
    <div class="search-drawer__tags">
      {%- assign default_suggestions = "Hoodie,Cargo Pants,Streetwear,Anime,Oversized" | split: ',' -%}
      {%- assign config_suggestions = settings.search_suggestions | split: ',' -%}
      {%- assign suggestions_to_use = config_suggestions -%}
      {%- if settings.search_suggestions == blank or suggestions_to_use.size == 0 -%}
        {%- assign suggestions_to_use = default_suggestions -%}
      {%- endif -%}
      {%- for suggestion in suggestions_to_use -%}
        <a href="{{ routes.search_url }}?type=product&q={{ suggestion | strip | url_encode }}" class="search-drawer__tag">{{ suggestion | strip }}</a>
      {%- endfor -%}
    </div>
  </div>
  <div class="search-drawer__results" data-search-results></div>
</div>
<style>
  .search-drawer { position:fixed;top:0;right:0;height:100%;width:min(480px,100vw);background:#fff;z-index:100000 !important;transform:translateX(100%);transition:transform .35s cubic-bezier(.4,0,.2,1), visibility .35s;visibility:hidden;display:flex;flex-direction:column;overflow-y:auto;pointer-events:none; }
  .search-drawer.is-open { transform:translateX(0) !important; visibility:visible !important; pointer-events:auto !important; }
  .search-drawer-overlay { position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:99999 !important;opacity:0;visibility:hidden;pointer-events:none;transition:opacity .3s ease,visibility .3s ease; }
  .search-drawer-overlay.is-open { opacity:1 !important;visibility:visible !important;pointer-events:auto !important; }
  .search-drawer__header { display:flex;justify-content:space-between;align-items:center;padding:1.25rem 1.5rem;border-bottom:1px solid #f0f0f0; }
  .search-drawer__title { font-size:1.15rem;font-weight:700;margin:0;letter-spacing:-0.02em; }
  .search-drawer__close { width:36px;height:36px;border-radius:50%;display:flex;align-items:center;justify-content:center;background:none;border:none;cursor:pointer; }
  .search-drawer__close:hover { background:#f5f5f5; }
  .search-drawer__form-wrap { padding:1.25rem 1.5rem 0.75rem; }
  .search-drawer__input-wrap { display:flex;align-items:center;border:2px solid #e5e5e5;border-radius:var(--button-radius,8px);overflow:hidden;transition:border-color .2s;background:#fff; }
  .search-drawer__input-wrap:focus-within { border-color:var(--color-primary,#111); }
  .search-drawer__icon { padding:.75rem;color:#888;display:flex;align-items:center; }
  .search-drawer__input { flex:1;border:none;outline:none;font-size:1rem;padding:.75rem 0;background:transparent;color:#111; }
  .search-drawer__submit { padding:.75rem 1rem;background:var(--color-primary,#111);color:#fff;border:none;cursor:pointer;display:flex;align-items:center;justify-content:center; }
  .search-drawer__suggestions { padding:0.5rem 1.5rem 1.25rem; }
  .search-drawer__suggestions-label { font-size:.75rem;font-weight:700;color:#888;text-transform:uppercase;letter-spacing:.08em;margin-bottom:.5rem; }
  .search-drawer__tags { display:flex;flex-wrap:wrap;gap:.5rem; }
  .search-drawer__tag { padding:.35rem .85rem;background:#f5f5f5;border-radius:20px;font-size:.8125rem;color:#333;text-decoration:none;transition:background .2s,color .2s; }
  .search-drawer__tag:hover { background:var(--color-primary,#111);color:#fff; }
  .search-drawer__results { padding:0 1.5rem 1.5rem; }
  .search-result-item { display:flex;gap:1rem;padding:.75rem 0;border-bottom:1px solid #f5f5f5;align-items:center;text-decoration:none;color:inherit; }
  .search-result-item__image { width:56px;height:56px;border-radius:8px;overflow:hidden;flex-shrink:0;background:#eee; }
  .search-result-item__image img { width:100%;height:100%;object-fit:cover; }
  .search-result-item__info { flex:1; }
  .search-result-item__title { font-size:.9rem;font-weight:600;margin:0 0 .2rem;color:#111; }
  .search-result-item__price { font-size:.85rem;color:#666;font-weight:500;margin:0; }
  .search-drawer__no-results { text-align:center;color:#888;padding:2rem 0;font-size:0.95rem; }
</style>
{% schema %}
{
  "name": "Search Drawer",
  "tag": "div",
  "class": "section-search-drawer"
}
{% endschema %}
