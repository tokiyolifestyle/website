{%- comment -%}
  TOKIYO LIFESTYLE - Ganesh Puja Festive Combo / Bundle Builder Section
  - Hero image removed (shows bundle customization directly)
  - Ganesh Puja Theme: Ganesha & Mooshak (Namaste Mouse) + Golden Modak + Anime Avatar
  - Animated Festive Snow & Sparkle Rain Effect
{%- endcomment -%}

{%- assign is_bundle = false -%}
{%- if product.type == 'Combo Bundle' or product.tags contains 'bundle' -%}
  {%- assign is_bundle = true -%}
{%- endif -%}

{%- assign bundle_handle = product.handle -%}
{%- assign item_handles = '' -%}

{%- case bundle_handle -%}
  {%- when 'womens-festive-trio-buy-3' -%}
    {%- assign item_handles = 'tokiyo-lifestyle-women-oversized-t-shirt-tovwo012,tokiyo-lifestyle-women-oversized-t-shirt-tovwo003,tokiyo-lifestyle-women-oversized-t-shirt-tovwo005' -%}
    {%- assign bundle_badge = "Bappa's Blessings Special — Buy 3 @ Rs. 1969" -%}
    {%- assign bundle_title_custom = "Women's Festive Trio (3 Oversized Tees)" -%}
  {%- when 'womens-festive-duo-buy-2' -%}
    {%- assign item_handles = 'tokiyo-lifestyle-women-oversized-t-shirt-tovwo003,tokiyo-lifestyle-women-oversized-t-shirt-tovwo005' -%}
    {%- assign bundle_badge = "Ganesh Utsav Special — Buy 2 @ Rs. 1349" -%}
    {%- assign bundle_title_custom = "Women's Festive Duo (2 Oversized Tees)" -%}
  {%- when 'mens-festive-duo-buy-2' -%}
    {%- assign item_handles = 'tokiyo-lifestyle-oversized-t-shirt-totm038,tokiyo-lifestyle-oversized-t-shirt-totm008' -%}
    {%- assign bundle_badge = "Ganesh Utsav Special — Buy 2 @ Rs. 1269" -%}
    {%- assign bundle_title_custom = "Men's Festive Duo (2 Oversized Tees)" -%}
  {%- when 'mens-festive-trio-buy-3' -%}
    {%- assign item_handles = 'tokiyo-lifestyle-oversized-t-shirt-totm038,tokiyo-lifestyle-oversized-t-shirt-totm006,tokiyo-lifestyle-oversized-t-shirt-totm008' -%}
    {%- assign bundle_badge = "Bappa's Blessings Special — Buy 3 @ Rs. 1869" -%}
    {%- assign bundle_title_custom = "Men's Festive Trio (3 Oversized Tees)" -%}
  {%- else -%}
    {%- assign item_handles = 'tokiyo-lifestyle-oversized-t-shirt-totm038,tokiyo-lifestyle-oversized-t-shirt-totm008' -%}
    {%- assign bundle_badge = "Bappa's Festive Combo Offer" -%}
    {%- assign bundle_title_custom = product.title -%}
{%- endcase -%}

{%- assign clean_product_title = bundle_title_custom | default: product.title -%}
{%- assign clean_bundle_badge = bundle_badge -%}

{%- assign handle_array = item_handles | split: ',' -%}
{%- assign item_count = handle_array.size -%}

{%- comment -%} ── Festive Snow & Sparkle Rain Container ── {%- endcomment -%}
<div class="festive-rain-container" id="FestiveRainContainer" aria-hidden="true"></div>

{%- assign bundle_var_id = product.selected_or_first_available_variant.id | default: product.variants.first.id -%}
<div id="bundle-selector" class="bundle-page page-width" data-bundle-builder data-bundle-id="{{ product.id }}" data-bundle-variant-id="{{ bundle_var_id }}" data-bundle-price="{{ product.price }}">
  
  <div class="bundle-page__header">
    <div class="bundle-page__badge">
      <span class="bundle-page__badge-icon">✦</span>
      <span>{{ clean_bundle_badge }}</span>
    </div>
    <h1 class="bundle-page__title">{{ clean_product_title }}</h1>
    <p class="bundle-page__subtitle">Select color &amp; size for each tee below — festive combo offer unlocked!</p>
  </div>

  <div class="bundle-page__layout">
    <div class="bundle-page__items">
      {%- for handle in handle_array -%}
        {%- assign bundled_product = all_products[handle] -%}
        {%- if bundled_product != blank -%}
          <div class="bundle-item-card" data-bundle-item="{{ forloop.index }}" data-product-handle="{{ bundled_product.handle }}" data-product-title="{{ bundled_product.title }}">
            <div class="bundle-item-card__header">
              <span class="bundle-item-card__step">ITEM {{ forloop.index }} OF {{ item_count }}</span>
              <span class="bundle-item-card__status" data-item-status>Select Options</span>
            </div>

            <div class="bundle-item-card__body">
              <div class="bundle-item-card__image-wrap">
                <img 
                  src="{{ bundled_product.featured_image | image_url: width: 600 }}" 
                  alt="{{ bundled_product.title | escape }}" 
                  class="bundle-item-card__img" 
                  data-item-image
                  loading="eager"
                  width="300"
                  height="360"
                >
              </div>

              <div class="bundle-item-card__details">
                <h3 class="bundle-item-card__title">
                  <a href="{{ bundled_product.url }}" target="_blank" rel="noopener">{{ bundled_product.title }}</a>
                </h3>

                {%- for option in bundled_product.options_with_values -%}
                  {%- if option.name == 'Color' or option.name == 'Colour' -%}
                    <div class="bundle-item-card__option-group" data-option-group="color">
                      <div class="bundle-item-card__option-header">
                        <span class="bundle-item-card__option-label">Color:</span>
                        <span class="bundle-item-card__option-value" data-selected-color>{{ option.values.first }}</span>
                      </div>
                      <div class="bundle-item-card__swatches">
                        {%- for val in option.values -%}
                          {%- assign val_lower = val | downcase | replace: ' ', '' -%}
                          {%- assign color_img_url = '' -%}
                          {%- for v in bundled_product.variants -%}
                            {%- if v.options contains val and v.image != blank -%}
                              {%- assign color_img_url = v.image | image_url: width: 600 -%}
                              {%- break -%}
                            {%- endif -%}
                          {%- endfor -%}
                          <button 
                            type="button" 
                            class="bundle-swatch {% if forloop.first %}is-active{% endif %}" 
                            data-swatch-val="{{ val | escape }}" 
                            data-swatch-img="{{ color_img_url }}"
                            aria-label="Select {{ val }}"
                          >
                            <span class="bundle-swatch__circle swatch-{{ val_lower }}"></span>
                            <span class="bundle-swatch__name">{{ val }}</span>
                          </button>
                        {%- endfor -%}
                      </div>
                    </div>
                  {%- endif -%}
                {%- endfor -%}

                {%- for option in bundled_product.options_with_values -%}
                  {%- if option.name == 'Size' -%}
                    <div class="bundle-item-card__option-group" data-option-group="size">
                      <div class="bundle-item-card__option-header">
                        <span class="bundle-item-card__option-label">Size:</span>
                        <span class="bundle-item-card__option-value" data-selected-size>M</span>
                      </div>
                      <div class="bundle-item-card__sizes">
                        {%- assign has_size_m = false -%}
                        {%- if option.values contains 'M' -%}{%- assign has_size_m = true -%}{%- endif -%}
                        {%- for val in option.values -%}
                          <button 
                            type="button" 
                            class="bundle-size-btn {% if val == 'M' or forloop.first and has_size_m == false %}is-active{% endif %}" 
                            data-size-val="{{ val | escape }}"
                          >
                            {{ val }}
                          </button>
                        {%- endfor -%}
                      </div>
                    </div>
                  {%- endif -%}
                {%- endfor -%}

              </div>
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="bundle-page__summary-wrap">
      <div class="bundle-summary-card ganesh-summary-card">
        <div class="bundle-summary-card__festive-tag">
          🥮 Bappa's Festive Summary
        </div>

        <h3 class="bundle-summary-card__title">{{ bundle_title_custom | replace: '₹', 'Rs. ' }}</h3>

        <div class="bundle-summary-card__breakdown" data-summary-breakdown>
          {%- for handle in handle_array -%}
            {%- assign bp = all_products[handle] -%}
            <div class="bundle-summary-card__row" data-summary-row="{{ forloop.index }}">
              <span class="bundle-summary-card__item-name">{{ bp.title | replace: 'Tokiyo Lifestyle ', '' | truncate: 22 }}</span>
              <span class="bundle-summary-card__item-choice" data-summary-choice>Loading...</span>
            </div>
          {%- endfor -%}
        </div>

        <div class="bundle-summary-card__divider"></div>

        <div class="bundle-summary-card__pricing">
          <div class="bundle-summary-card__price-row">
            <span class="bundle-summary-card__price-label">Bundle Price:</span>
            <span class="bundle-summary-card__price-val">{{ product.price | money }}</span>
          </div>
          {%- if product.compare_at_price > product.price -%}
            <div class="bundle-summary-card__price-row bundle-summary-card__price-row--compare">
              <span class="bundle-summary-card__price-label">Total Value:</span>
              <span class="bundle-summary-card__compare-val">{{ product.compare_at_price | money }}</span>
            </div>
            {%- assign save_amt = product.compare_at_price | minus: product.price -%}
            <div class="bundle-summary-card__savings">
              You Save {{ save_amt | money }} (Ganesh Utsav Offer)
            </div>
          {%- endif -%}
        </div>

        <div class="bundle-summary-card__perks">
          <span>✓ Free Shipping on Prepaid Orders</span>
          <span>✓ 100% Premium 240 GSM Cotton</span>
          <span>✓ Easy 7-Day Replacement</span>
        </div>

        <button type="button" class="bundle-summary-card__btn ganesh-btn" data-add-bundle-btn>
          <span class="bundle-btn__text">ADD BUNDLE TO CART • {{ product.price | money }}</span>
          <span class="bundle-btn__spinner" style="display:none;">Adding...</span>
        </button>
        
        <p class="bundle-summary-card__footnote">Ganpati Bappa Morya! Offer auto-applied in cart.</p>
      </div>
    </div>
  </div>
</div>

<style>
