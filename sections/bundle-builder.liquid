.bundle-summary-card__price-label { font-size: 13px; color: rgba(255, 255, 255, 0.7); }
.bundle-summary-card__price-val { font-size: 26px !important; font-weight: 900 !important; color: #ffffff !important; }
.bundle-summary-card__compare-val { font-size: 14px; text-decoration: line-through; color: rgba(255, 255, 255, 0.4); }
.bundle-summary-card__savings {
  display: inline-block;
  background: rgba(0, 230, 118, 0.12);
  border: 1px solid rgba(0, 230, 118, 0.3);
  color: #00e676;
