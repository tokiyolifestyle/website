<script>
(function() {
  // ── Festive Snow & Sparkles Rain Script ──
  function createFestiveRain() {
    const container = document.getElementById('FestiveRainContainer');
    if (!container) return;

    const symbols = ['❄', '✦', '🥮', '🌸', '✨', '✦', '❄', '✨'];
    const particleCount = 28;

    for (let i = 0; i < particleCount; i++) {
      const flake = document.createElement('span');
      flake.className = 'festive-flake';
      flake.textContent = symbols[Math.floor(Math.random() * symbols.length)];
      
      const leftPos = Math.random() * 100;
      const duration = 5 + Math.random() * 8;
      const delay = Math.random() * 8;
      const size = 12 + Math.random() * 16;
      const opacity = 0.4 + Math.random() * 0.5;

      flake.style.left = leftPos + 'vw';
      flake.style.animationDuration = duration + 's';
      flake.style.animationDelay = delay + 's';
      flake.style.fontSize = size + 'px';
      flake.style.opacity = opacity;

      container.appendChild(flake);
    }
  }

  function setupBundleBuilder() {
    createFestiveRain();

    const container = document.querySelector('[data-bundle-builder]');
    if (!container || container.dataset.initialized) return;
    container.dataset.initialized = 'true';

    const itemCards = container.querySelectorAll('[data-bundle-item]');
    const breakdownContainer = container.querySelector('[data-summary-breakdown]');
    const addBtn = container.querySelector('[data-add-bundle-btn]');
    const bundleVariantId = container.dataset.bundleVariantId;

    const selections = {};

    itemCards.forEach(function(card) {
      const itemNum = card.dataset.bundleItem;
      const title = card.dataset.productTitle;
      const activeSwatch = card.querySelector('.bundle-swatch.is-active');
      const activeSize = card.querySelector('.bundle-size-btn.is-active');

      selections[itemNum] = {
        title: title,
        color: activeSwatch ? activeSwatch.dataset.swatchVal : '',
        size: activeSize ? activeSize.dataset.sizeVal : 'M',
        colorImg: activeSwatch ? activeSwatch.dataset.swatchImg : ''
      };

      card.querySelectorAll('.bundle-swatch').forEach(function(btn) {
        btn.addEventListener('click', function() {
          card.querySelectorAll('.bundle-swatch').forEach(s => s.classList.remove('is-active'));
          this.classList.add('is-active');
          const colorVal = this.dataset.swatchVal;
          const colorImg = this.dataset.swatchImg;
          card.querySelector('[data-selected-color]').textContent = colorVal;
          selections[itemNum].color = colorVal;
          if (colorImg) {
            const imgElem = card.querySelector('[data-item-image]');
            if (imgElem) imgElem.src = colorImg;
          }
          updateSummary();
        });
      });

      card.querySelectorAll('.bundle-size-btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
          card.querySelectorAll('.bundle-size-btn').forEach(s => s.classList.remove('is-active'));
          this.classList.add('is-active');
          const sizeVal = this.dataset.sizeVal;
          card.querySelector('[data-selected-size]').textContent = sizeVal;
          selections[itemNum].size = sizeVal;
          updateSummary();
        });
      });
    });

    function updateSummary() {
      Object.keys(selections).forEach(function(num) {
        if (breakdownContainer) {
          const row = breakdownContainer.querySelector(`[data-summary-row="${num}"]`);
          if (row) {
            const choiceSpan = row.querySelector('[data-summary-choice]');
            const item = selections[num];
            choiceSpan.textContent = `${item.color} / ${item.size}`;
          }
        }
        const card = container.querySelector(`[data-bundle-item="${num}"]`);
        if (card) {
          const statusSpan = card.querySelector('[data-item-status]');
          if (selections[num].color && selections[num].size) {
            statusSpan.textContent = `✓ ${selections[num].color}, ${selections[num].size}`;
            statusSpan.classList.add('is-ready');
          }
        }
      });
    }

    updateSummary();

    if (addBtn) {
      addBtn.addEventListener('click', function() {
        const btnText = addBtn.querySelector('.bundle-btn__text');
        const btnSpinner = addBtn.querySelector('.bundle-btn__spinner');
        btnText.style.display = 'none';
        btnSpinner.style.display = 'inline-block';
        addBtn.disabled = true;

        const properties = { "_is_bundle": "true" };
        const itemsToAdd = [];

        itemCards.forEach(function(card) {
          const itemNum = card.dataset.bundleItem;
          const sel = selections[itemNum];
          if (!sel) return;
          properties[`Item ${itemNum}`] = `${sel.title} (${sel.color} / ${sel.size})`;

          const variantsJson = card.querySelector('[data-variants-json]');
          if (variantsJson) {
            try {
              const variants = JSON.parse(variantsJson.textContent);
              const targetColor = (sel.color || '').toLowerCase().trim();
              const targetSize = (sel.size || '').toLowerCase().trim();
              const match = variants.find(v => {
                const opts = v.options.map(o => String(o).toLowerCase().trim());
                const colorMatch = !targetColor || opts.some(o => o === targetColor || targetColor.includes(o) || o.includes(targetColor));
                const sizeMatch = !targetSize || opts.some(o => o === targetSize);
                return colorMatch && sizeMatch;
              }) || variants.find(v => v.available) || variants[0];

              if (match && match.id) {
                itemsToAdd.push({
                  id: parseInt(match.id),
                  quantity: 1,
                  properties: {
                    "_bundle_title": "{{ clean_product_title | escape }}",
                    "Selected Color": sel.color,
                    "Selected Size": sel.size
                  }
                });
              }
            } catch(e) {
              console.error("Variant parse error:", e);
            }
          }
        });

        const targetVarId = parseInt(bundleVariantId) || parseInt("{{ product.variants.first.id }}");
        let payloadItems = [];

        if (targetVarId && !isNaN(targetVarId)) {
          payloadItems.push({ id: targetVarId, quantity: 1, properties: properties });
        } else if (itemsToAdd.length > 0) {
          payloadItems = itemsToAdd;
        } else {
          btnText.style.display = 'inline-block';
          btnSpinner.style.display = 'none';
          addBtn.disabled = false;
          alert("Please select color and size for all items.");
          return;
        }

        function onSuccessAdd(data) {
          if (window.TokiyoCart && typeof window.TokiyoCart.openDrawer === 'function') {
            window.TokiyoCart.openDrawer();
          } else if (window.CartDrawer && typeof window.CartDrawer.open === 'function') {
            window.CartDrawer.open();
          } else if (typeof window.openCartDrawer === 'function') {
            window.openCartDrawer();
          } else {
            const toggle = document.querySelector('[data-cart-drawer-toggle]');
            if (toggle) {
              toggle.click();
            } else if (document.querySelector('[data-cart-drawer]')) {
              document.querySelector('[data-cart-drawer]').classList.add('is-open');
              document.body.classList.add('cart-drawer-open');
            } else {
              window.location.href = '/cart';
            }
          }
        }

        fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ items: payloadItems })
        })
        .then(res => res.json())
        .then(cartData => {
          btnText.style.display = 'inline-block';
          btnSpinner.style.display = 'none';
          addBtn.disabled = false;

          if (cartData.status && cartData.status >= 400) {
            if (payloadItems.length === 1 && itemsToAdd.length > 0) {
              return fetch('/cart/add.js', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ items: itemsToAdd })
              })
              .then(r => r.json())
              .then(secondTryData => {
                if (secondTryData.status && secondTryData.status >= 400) {
                  alert("Could not add items to cart: " + (secondTryData.description || secondTryData.message));
                  return;
                }
                onSuccessAdd(secondTryData);
              });
            } else {
              alert("Could not add bundle to cart: " + (cartData.description || cartData.message));
              return;
            }
          }

          onSuccessAdd(cartData);
        })
        .catch(err => {
          console.error("Error adding bundle to cart:", err);
          btnText.style.display = 'inline-block';
          btnSpinner.style.display = 'none';
          addBtn.disabled = false;
          alert("Could not add bundle to cart. Please try again.");
        });
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupBundleBuilder);
  } else {
    setupBundleBuilder();
  }
})();
</script>

{% schema %}
{
  "name": "Bundle Builder",
  "settings": []
}
{% endschema %}
