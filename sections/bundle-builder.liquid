{%- comment -%}
  TOKIYO LIFESTYLE - Premium Interactive Festive Combo / Bundle Builder Section
  Self-contained, high-performance, responsive layout
{%- endcomment -%}

{%- assign is_bundle = false -%}
{%- if product.type == 'Combo Bundle' or product.tags contains 'bundle' -%}
  {%- assign is_bundle = true -%}
{%- endif -%}

{%- assign bundle_handle = product.handle -%}
{%- assign item_handles = '' -%}

{%- case bundle_handle -%}
  {%- when 'womens-festive-trio-buy-3' -%}
    {%- assign item_handles = 'tokiyo-lifestyle-women-oversized-t-shirt-tovwo012,tokiyo-lifestyle-women-oversized-t-shirt-tovwo003,tokiyo-lifestyle-women-oversized-t-shirt-tovwo005' -%}
    {%- assign bundle_badge = "Bappa's Blessings Special — Buy 3 @ Rs. 1969" -%}
    {%- assign bundle_title_custom = "Women's Festive Trio (3 Oversized Tees)" -%}
  {%- when 'womens-festive-duo-buy-2' -%}
    {%- assign item_handles = 'tokiyo-lifestyle-women-oversized-t-shirt-tovwo003,tokiyo-lifestyle-women-oversized-t-shirt-tovwo005' -%}
    {%- assign bundle_badge = "Festive Duo Special — Buy 2 @ Rs. 1349" -%}
    {%- assign bundle_title_custom = "Women's Festive Duo (2 Oversized Tees)" -%}
  {%- when 'mens-festive-duo-buy-2' -%}
    {%- assign item_handles = 'tokiyo-lifestyle-oversized-t-shirt-totm038,tokiyo-lifestyle-oversized-t-shirt-totm008' -%}
    {%- assign bundle_badge = "Festive Duo Special — Buy 2 @ Rs. 1269" -%}
    {%- assign bundle_title_custom = "Men's Festive Duo (2 Oversized Tees)" -%}
  {%- when 'mens-festive-trio-buy-3' -%}
    {%- assign item_handles = 'tokiyo-lifestyle-oversized-t-shirt-totm038,tokiyo-lifestyle-oversized-t-shirt-totm006,tokiyo-lifestyle-oversized-t-shirt-totm008' -%}
    {%- assign bundle_badge = "Festive Trio Special — Buy 3 @ Rs. 1869" -%}
    {%- assign bundle_title_custom = "Men's Festive Trio (3 Oversized Tees)" -%}
  {%- else -%}
    {%- assign item_handles = 'tokiyo-lifestyle-oversized-t-shirt-totm038,tokiyo-lifestyle-oversized-t-shirt-totm008' -%}
    {%- assign bundle_badge = "Festive Combo Offer" -%}
    {%- assign bundle_title_custom = product.title -%}
{%- endcase -%}

{%- assign clean_product_title = product.title | replace: '₹', 'Rs. ' | replace: '(Buy', '— Buy' | replace: ')', '' -%}
{%- assign clean_bundle_badge = bundle_badge | replace: '₹', 'Rs. ' -%}

{%- assign handle_array = item_handles | split: ',' -%}
{%- assign item_count = handle_array.size -%}

{%- comment -%} ── Full-width Bundle Hero Banner ── {%- endcomment -%}
<div class="bundle-hero" data-bundle-hero>
  <div class="bundle-hero__bg" aria-hidden="true">
    <div class="bundle-hero__glow bundle-hero__glow--1"></div>
    <div class="bundle-hero__glow bundle-hero__glow--2"></div>
  </div>

  <div class="bundle-hero__inner page-width">
    <div class="bundle-hero__left">
      <div class="bundle-hero__eyebrow">
        <span class="bundle-hero__star">✦</span>
        <span>{{ clean_bundle_badge }}</span>
      </div>
      <h1 class="bundle-hero__title">{{ clean_product_title }}</h1>
      <p class="bundle-hero__sub">Choose your size &amp; color for each tee below. Special combo pricing applied instantly.</p>

      <div class="bundle-hero__perks">
        <span>✓ Free Shipping Prepaid</span>
        <span>✓ 240 GSM Premium Cotton</span>
        <span>✓ 7-Day Easy Replace</span>
      </div>

      <div class="bundle-hero__price-block">
        <span class="bundle-hero__price">{{ product.price | money }}</span>
        {%- if product.compare_at_price > product.price -%}
          <span class="bundle-hero__compare">{{ product.compare_at_price | money }}</span>
          {%- assign save_pct = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price -%}
          <span class="bundle-hero__save">{{ save_pct }}% OFF</span>
        {%- endif -%}
      </div>

      <a href="#bundle-selector" class="bundle-hero__cta">
        BUILD YOUR BUNDLE
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    </div>

    <div class="bundle-hero__right">
      {%- assign preview_count = 0 -%}
      {%- for handle in handle_array -%}
        {%- assign prev_p = all_products[handle] -%}
        {%- if prev_p != blank and preview_count < 3 -%}
          <div class="bundle-hero__tee bundle-hero__tee--{{ forloop.index }}">
            {%- if prev_p.featured_image != blank -%}
              <img
                src="{{ prev_p.featured_image | image_url: width: 500 }}"
                alt="{{ prev_p.title | escape }}"
                class="bundle-hero__tee-img"
                loading="eager"
              >
            {%- endif -%}
            {%- assign tee_label = prev_p.title | replace: 'Tokiyo Lifestyle ', '' | replace: 'Women Oversized T-Shirt - ', '' | replace: 'Oversized T-Shirt - ', '' | replace: 'Oversized T-Shirt', '' | strip | truncate: 18 -%}
            <span class="bundle-hero__tee-tag">{{ tee_label }}</span>
          </div>
          {%- assign preview_count = preview_count | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

<div id="bundle-selector" class="bundle-page page-width" data-bundle-builder data-bundle-id="{{ product.id }}" data-bundle-variant-id="{{ product.selected_or_first_available_variant.id }}" data-bundle-price="{{ product.price }}">
  
  <div class="bundle-page__header">
    <div class="bundle-page__badge">
      <span class="bundle-page__badge-icon">✦</span>
      <span>FESTIVE COMBO OFFER</span>
    </div>
    <h2 class="bundle-page__title">Customise Your Bundle</h2>
    <p class="bundle-page__subtitle">Select color &amp; size for each tee — discount automatically applied.</p>
  </div>

  <div class="bundle-page__layout">
    <div class="bundle-page__items">
      {%- for handle in handle_array -%}
        {%- assign bundled_product = all_products[handle] -%}
        {%- if bundled_product != blank -%}
          <div class="bundle-item-card" data-bundle-item="{{ forloop.index }}" data-product-handle="{{ bundled_product.handle }}" data-product-title="{{ bundled_product.title }}">
            <div class="bundle-item-card__header">
              <span class="bundle-item-card__step">ITEM {{ forloop.index }} OF {{ item_count }}</span>
              <span class="bundle-item-card__status" data-item-status>Select Options</span>
            </div>

            <div class="bundle-item-card__body">
              <div class="bundle-item-card__image-wrap">
                <img 
                  src="{{ bundled_product.featured_image | image_url: width: 600 }}" 
                  alt="{{ bundled_product.title | escape }}" 
                  class="bundle-item-card__img" 
                  data-item-image
                  loading="eager"
                  width="300"
                  height="360"
                >
              </div>

              <div class="bundle-item-card__details">
                <h3 class="bundle-item-card__title">
                  <a href="{{ bundled_product.url }}" target="_blank" rel="noopener">{{ bundled_product.title }}</a>
                </h3>

                {%- for option in bundled_product.options_with_values -%}
                  {%- if option.name == 'Color' or option.name == 'Colour' -%}
                    <div class="bundle-item-card__option-group" data-option-group="color">
                      <div class="bundle-item-card__option-header">
                        <span class="bundle-item-card__option-label">Color:</span>
                        <span class="bundle-item-card__option-value" data-selected-color>{{ option.values.first }}</span>
                      </div>
                      <div class="bundle-item-card__swatches">
                        {%- for val in option.values -%}
                          {%- assign val_lower = val | downcase | replace: ' ', '' -%}
                          {%- assign color_img_url = '' -%}
                          {%- for v in bundled_product.variants -%}
                            {%- if v.options contains val and v.image != blank -%}
                              {%- assign color_img_url = v.image | image_url: width: 600 -%}
                              {%- break -%}
                            {%- endif -%}
                          {%- endfor -%}
                          <button 
                            type="button" 
                            class="bundle-swatch {% if forloop.first %}is-active{% endif %}" 
                            data-swatch-val="{{ val | escape }}" 
                            data-swatch-img="{{ color_img_url }}"
                            aria-label="Select {{ val }}"
                          >
                            <span class="bundle-swatch__circle swatch-{{ val_lower }}"></span>
                            <span class="bundle-swatch__name">{{ val }}</span>
                          </button>
                        {%- endfor -%}
                      </div>
                    </div>
                  {%- endif -%}
                {%- endfor -%}

                {%- for option in bundled_product.options_with_values -%}
                  {%- if option.name == 'Size' -%}
                    <div class="bundle-item-card__option-group" data-option-group="size">
                      <div class="bundle-item-card__option-header">
                        <span class="bundle-item-card__option-label">Size:</span>
                        <span class="bundle-item-card__option-value" data-selected-size>M</span>
                      </div>
                      <div class="bundle-item-card__sizes">
                        {%- assign has_size_m = false -%}
                        {%- if option.values contains 'M' -%}{%- assign has_size_m = true -%}{%- endif -%}
                        {%- for val in option.values -%}
                          <button 
                            type="button" 
                            class="bundle-size-btn {% if val == 'M' or forloop.first and has_size_m == false %}is-active{% endif %}" 
                            data-size-val="{{ val | escape }}"
                          >
                            {{ val }}
                          </button>
                        {%- endfor -%}
                      </div>
                    </div>
                  {%- endif -%}
                {%- endfor -%}

              </div>
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="bundle-page__summary-wrap">
      <div class="bundle-summary-card">
        <div class="bundle-summary-card__festive-tag">
          ✦ Festive Offer Summary
        </div>

        <h3 class="bundle-summary-card__title">{{ bundle_title_custom | replace: '₹', 'Rs. ' }}</h3>

        <div class="bundle-summary-card__breakdown" data-summary-breakdown>
          {%- for handle in handle_array -%}
            {%- assign bp = all_products[handle] -%}
            <div class="bundle-summary-card__row" data-summary-row="{{ forloop.index }}">
              <span class="bundle-summary-card__item-name">{{ bp.title | replace: 'Tokiyo Lifestyle ', '' | truncate: 22 }}</span>
              <span class="bundle-summary-card__item-choice" data-summary-choice>Loading...</span>
            </div>
          {%- endfor -%}
        </div>

        <div class="bundle-summary-card__divider"></div>

        <div class="bundle-summary-card__pricing">
          <div class="bundle-summary-card__price-row">
            <span class="bundle-summary-card__price-label">Bundle Price:</span>
            <span class="bundle-summary-card__price-val">{{ product.price | money }}</span>
          </div>
          {%- if product.compare_at_price > product.price -%}
            <div class="bundle-summary-card__price-row bundle-summary-card__price-row--compare">
              <span class="bundle-summary-card__price-label">Total Value:</span>
              <span class="bundle-summary-card__compare-val">{{ product.compare_at_price | money }}</span>
            </div>
            {%- assign save_amt = product.compare_at_price | minus: product.price -%}
            <div class="bundle-summary-card__savings">
              You Save {{ save_amt | money }} (Festive Deal)
            </div>
          {%- endif -%}
        </div>

        <div class="bundle-summary-card__perks">
          <span>✓ Free Shipping on Prepaid Orders</span>
          <span>✓ 100% Premium 240 GSM Cotton</span>
          <span>✓ Easy 7-Day Replacement</span>
        </div>

        <button type="button" class="bundle-summary-card__btn" data-add-bundle-btn>
          <span class="bundle-btn__text">ADD BUNDLE TO CART • {{ product.price | money }}</span>
          <span class="bundle-btn__spinner" style="display:none;">Adding...</span>
        </button>
        
        <p class="bundle-summary-card__footnote">Special combo deal will be reflected in checkout.</p>
      </div>
    </div>
  </div>
</div>

<style>
/* Reset & Modern Typography Enforcement */
.bundle-hero,
.bundle-hero *,
.bundle-page,
.bundle-page * {
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif !important;
  box-sizing: border-box;
}

/* ═══════════════════════════════════════════
   BUNDLE HERO BANNER (PREMIUM DARK)
═══════════════════════════════════════════ */
.bundle-hero {
  position: relative;
  width: 100%;
  min-height: 480px;
  background: #080808;
  overflow: hidden;
  display: flex;
  align-items: center;
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}

.bundle-hero__bg { position: absolute; inset: 0; z-index: 0; pointer-events: none; }
.bundle-hero__glow {
  position: absolute;
  border-radius: 50%;
  filter: blur(90px);
  opacity: 0.28;
}
.bundle-hero__glow--1 {
  width: 450px; height: 450px;
  background: radial-gradient(circle, #ff0000 0%, transparent 70%);
  top: -100px; left: -80px;
}
.bundle-hero__glow--2 {
  width: 380px; height: 380px;
  background: radial-gradient(circle, #ff3300 0%, transparent 70%);
  bottom: -80px; right: -60px;
}

.bundle-hero__inner {
  position: relative; z-index: 2;
  display: grid;
  grid-template-columns: 1.1fr 0.9fr;
  gap: 40px;
  align-items: center;
  padding-top: 48px;
  padding-bottom: 48px;
}

.bundle-hero__eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: rgba(255, 0, 0, 0.12);
  border: 1px solid rgba(255, 0, 0, 0.35);
  color: #ff4444;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  padding: 6px 14px;
  border-radius: 999px;
  margin-bottom: 18px;
}

.bundle-hero__title {
  font-size: clamp(24px, 4vw, 44px) !important;
  font-weight: 900 !important;
  color: #ffffff !important;
  line-height: 1.15 !important;
  letter-spacing: -0.02em !important;
  margin-top: 0;
  margin-bottom: 14px;
  text-transform: uppercase;
}

.bundle-hero__sub {
  font-size: 14px;
  color: rgba(255, 255, 255, 0.65);
  line-height: 1.6;
  margin-bottom: 20px;
}

.bundle-hero__perks {
  display: flex;
  flex-wrap: wrap;
  gap: 8px 16px;
  margin-bottom: 24px;
}
.bundle-hero__perks span {
  font-size: 12px;
  color: rgba(255, 255, 255, 0.55);
  font-weight: 600;
}

.bundle-hero__price-block {
  display: flex;
  align-items: baseline;
  gap: 12px;
  margin-bottom: 28px;
  flex-wrap: wrap;
}
.bundle-hero__price {
  font-size: clamp(28px, 4.5vw, 42px) !important;
  font-weight: 900 !important;
  color: #ffffff !important;
}
.bundle-hero__compare {
  font-size: 18px;
  color: rgba(255, 255, 255, 0.4);
  text-decoration: line-through;
}
.bundle-hero__save {
  font-size: 12px;
  font-weight: 800;
  color: #00e676;
  background: rgba(0, 230, 118, 0.12);
  border: 1px solid rgba(0, 230, 118, 0.3);
  padding: 3px 10px;
  border-radius: 999px;
}

.bundle-hero__cta {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  background: #ff0000;
  color: #ffffff !important;
  font-size: 14px !important;
  font-weight: 800 !important;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  padding: 15px 30px;
  border-radius: 10px;
  text-decoration: none !important;
  transition: all 0.2s ease;
  box-shadow: 0 8px 25px rgba(255, 0, 0, 0.35);
}
.bundle-hero__cta:hover {
  background: #cc0000;
  transform: translateY(-2px);
  box-shadow: 0 12px 32px rgba(255, 0, 0, 0.45);
}

.bundle-hero__right {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  position: relative;
  min-height: 300px;
}
.bundle-hero__tee {
  position: absolute;
  bottom: 0;
  width: 160px;
  transition: transform 0.3s ease;
}
.bundle-hero__tee--1 { left: 10px; z-index: 3; transform: rotate(-5deg); }
.bundle-hero__tee--2 { left: 50%; transform: translateX(-50%); z-index: 4; }
.bundle-hero__tee--3 { right: 10px; z-index: 3; transform: rotate(5deg); }

.bundle-hero__tee-img {
  width: 100%;
  aspect-ratio: 4/5;
  object-fit: cover;
  border-radius: 12px;
  box-shadow: 0 16px 32px rgba(0,0,0,0.7);
  display: block;
}
.bundle-hero__tee-tag {
  display: block;
  text-align: center;
  margin-top: 6px;
  font-size: 10px;
  font-weight: 800;
  color: rgba(255,255,255,0.7);
  letter-spacing: 0.06em;
  text-transform: uppercase;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

@media (max-width: 749px) {
  .bundle-hero__inner {
    grid-template-columns: 1fr;
    gap: 24px;
    padding-top: 32px;
    padding-bottom: 32px;
  }
  .bundle-hero__right {
    min-height: 200px;
    order: -1;
  }
  .bundle-hero__tee { width: 110px; }
  .bundle-hero__cta {
    width: 100%;
    justify-content: center;
  }
}

/* ═══════════════════════════════════════════
   BUNDLE BUILDER SECTION
═══════════════════════════════════════════ */
.bundle-page {
  padding-top: 40px;
  padding-bottom: 80px;
}
.bundle-page__header {
  text-align: center;
  max-width: 700px;
  margin: 0 auto 36px;
}
.bundle-page__badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: rgba(255, 0, 0, 0.1);
  border: 1px solid rgba(255, 0, 0, 0.3);
  color: #ff3333;
  padding: 5px 14px;
  border-radius: 999px;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.1em;
  margin-bottom: 12px;
}
.bundle-page__title {
  font-size: clamp(22px, 3.5vw, 34px) !important;
  font-weight: 900 !important;
  color: #ffffff !important;
  margin: 0 0 10px !important;
  text-transform: uppercase;
}
.bundle-page__subtitle {
  font-size: 14px;
  color: rgba(255, 255, 255, 0.6);
  margin: 0;
}

.bundle-page__layout {
  display: grid;
  grid-template-columns: 1fr 370px;
  gap: 32px;
  align-items: start;
}

@media (max-width: 989px) {
  .bundle-page__layout {
    grid-template-columns: 1fr;
  }
}

/* ── Item Cards ── */
.bundle-page__items {
  display: flex;
  flex-direction: column;
  gap: 20px;
}
.bundle-item-card {
  background: #111111;
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 14px;
  padding: 20px;
  position: relative;
}
.bundle-item-card__header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16px;
  padding-bottom: 10px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}
.bundle-item-card__step {
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.1em;
  color: #ff3333;
}
.bundle-item-card__status {
  font-size: 12px;
  color: rgba(255, 255, 255, 0.5);
}
.bundle-item-card__status.is-ready {
  color: #00e676;
  font-weight: 700;
}

.bundle-item-card__body {
  display: grid;
  grid-template-columns: 130px 1fr;
  gap: 20px;
  align-items: start;
}
@media (max-width: 550px) {
  .bundle-item-card__body {
    grid-template-columns: 100px 1fr;
    gap: 14px;
  }
}

.bundle-item-card__image-wrap {
  aspect-ratio: 4 / 5;
  border-radius: 10px;
  overflow: hidden;
  background: #1a1a1a;
}
.bundle-item-card__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.bundle-item-card__title {
  font-size: 16px !important;
  font-weight: 700 !important;
  color: #ffffff !important;
  margin: 0 0 14px !important;
  line-height: 1.35 !important;
}
.bundle-item-card__title a {
  color: inherit;
  text-decoration: none;
}

.bundle-item-card__option-group {
  margin-bottom: 14px;
}
.bundle-item-card__option-header {
  display: flex;
  gap: 6px;
  font-size: 12px;
  margin-bottom: 8px;
}
.bundle-item-card__option-label { color: rgba(255, 255, 255, 0.5); }
.bundle-item-card__option-value { color: #ffffff; font-weight: 700; }

.bundle-item-card__swatches,
.bundle-item-card__sizes {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.bundle-swatch {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: #1a1a1a;
  border: 1px solid rgba(255, 255, 255, 0.15);
  border-radius: 8px;
  padding: 6px 12px;
  color: #dddddd;
  font-size: 12px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.18s;
}
.bundle-swatch.is-active {
  border-color: #ff3333;
  background: rgba(255, 0, 0, 0.15);
  color: #ffffff;
}
.bundle-swatch__circle {
  width: 10px; height: 10px;
  border-radius: 50%;
  border: 1px solid rgba(255, 255, 255, 0.25);
}
.swatch-black { background-color: #111; }
.swatch-beige { background-color: #d6c6b2; }
.swatch-white { background-color: #fff; }
.swatch-peach { background-color: #f7a88e; }
.swatch-lavender { background-color: #bfaee3; }

.bundle-size-btn {
  min-width: 40px;
  height: 36px;
  padding: 0 10px;
  background: #1a1a1a;
  border: 1px solid rgba(255, 255, 255, 0.15);
  border-radius: 8px;
  color: #dddddd;
  font-size: 12px;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.18s;
}
.bundle-size-btn.is-active {
  background: #ffffff;
  color: #000000;
  border-color: #ffffff;
}

/* ── Sticky Summary Card ── */
.bundle-page__summary-wrap {
  position: sticky;
  top: 90px;
  margin-bottom: 40px;
}
.bundle-summary-card {
  background: #141414;
  border: 1px solid rgba(255, 215, 0, 0.35);
  border-radius: 16px;
  padding: 24px;
  box-shadow: 0 16px 36px rgba(0, 0, 0, 0.7);
}
.bundle-summary-card__festive-tag {
  color: #ffd700;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  margin-bottom: 10px;
}
