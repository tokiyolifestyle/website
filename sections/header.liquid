<header class="site-header{% if section.settings.sticky_header %} site-header--sticky{% endif %}" data-site-header>
  <div class="site-header__inner page-width">

    <button class="site-header__mobile-toggle" data-mobile-nav-toggle aria-label="{{ 'sections.header.menu' | t }}" aria-expanded="false" aria-controls="MobileNav">
      {% render 'icon-menu' %}
    </button>

    <div class="site-header__logo">
      <a href="{{ routes.root_url }}" class="site-header__logo-link">
          <img src="{{ 'tokiyo-logo.jpeg' | asset_url }}" 
               loading="eager" 
               alt="{{ shop.name }}" 
               width="{{ settings.logo_width | default: 180 }}" 
               class="header__logo-img">
      </a>
    </div>

    <nav class="site-header__nav" aria-label="Primary">
      <ul class="site-header__nav-list" role="list">
        {%- for link in section.settings.main_menu.links -%}
          {%- assign is_catalog = false -%}
          {%- assign check_title = link.title | downcase -%}
          {%- if check_title == 'catalog' or check_title == 'catalogue' or check_title == 'categories' -%}
            {%- assign is_catalog = true -%}
          {%- endif -%}

          {%- if is_catalog -%}
            <li class="site-header__nav-item has-dropdown">
              <a href="/collections/all" class="site-header__nav-link" aria-haspopup="true" aria-expanded="false" data-mega-menu-trigger="categories">
                Categories
                {% render 'icon-chevron-down' %}
              </a>
              <div class="mega-menu" id="MegaMenu-categories" data-mega-menu>
                <div class="mega-menu__inner page-width">
                  <div class="mega-menu__columns">
                    <div class="mega-menu__column">
                      <a href="/collections/all" class="mega-menu__column-title mega-menu__column-title--all">Shop All Products →</a>
                    </div>
                    <div class="mega-menu__column">
                      <a href="/collections/men-oversized" class="mega-menu__column-title">Men's Oversized</a>
                      <ul class="mega-menu__list" role="list">
                        <li><a href="/collections/men-oversized-graphic-print">Graphic Print</a></li>
                        <li><a href="/collections/men-oversized-anime">Anime</a></li>
                        <li><a href="/collections/men-oversized-streetwear">Streetwear</a></li>
                        <li><a href="/collections/men-oversized-story-wear">Story Wear</a></li>
                        <li><a href="/collections/men-oversized-minimal">Minimal</a></li>
                        <li><a href="/collections/men-oversized-solid-basics">Solid Basics</a></li>
                      </ul>
                    </div>
                    <div class="mega-menu__column">
                      <a href="/collections/women-oversized" class="mega-menu__column-title">Women's Oversized</a>
                      <ul class="mega-menu__list" role="list">
                        <li><a href="/collections/women-oversized-graphic-print">Graphic Print</a></li>
                        <li><a href="/collections/women-oversized-anime">Anime</a></li>
                        <li><a href="/collections/women-oversized-streetwear">Streetwear</a></li>
                        <li><a href="/collections/women-oversized-story-wear">Story Wear</a></li>
                        <li><a href="/collections/women-oversized-minimal">Minimal</a></li>
                        <li><a href="/collections/women-oversized-solid-basics">Solid Basics</a></li>
                      </ul>
                    </div>
                  </div>
                </div>
              </div>
            </li>
          {%- else -%}
            <li class="site-header__nav-item{% if link.links.size > 0 %} has-dropdown{% endif %}">
              <a href="{{ link.url }}" class="site-header__nav-link{% if link.active or link.child_active %} is-active{% endif %}" {% if link.links.size > 0 %}aria-haspopup="true" aria-expanded="false" data-mega-menu-trigger="{{ link.handle }}"{% endif %}>
                {{ link.title }}
                {%- if link.links.size > 0 -%}{% render 'icon-chevron-down' %}{%- endif -%}
              </a>
              {%- if link.links.size > 0 -%}
                {% render 'mega-menu', link: link %}
              {%- endif -%}
            </li>
          {%- endif -%}
        {%- endfor -%}
        
        <li class="site-header__nav-item">
          <a href="/pages/about-us" class="site-header__nav-link{% if request.path == '/pages/about-us' %} is-active{% endif %}">About Us</a>
        </li>
        <li class="site-header__nav-item">
          <a href="/pages/bulk-order" class="site-header__nav-link{% if request.path == '/pages/bulk-order' %} is-active{% endif %}">Bulk Order</a>
        </li>
        <li class="site-header__nav-item">
          <a href="/blogs/news" class="site-header__nav-link{% if request.path contains '/blogs/' %} is-active{% endif %}">Blogs</a>
        </li>
      </ul>
    </nav>

    <div class="site-header__icons">
      {%- if section.settings.enable_search -%}
        <button class="site-header__icon-btn" data-search-drawer-toggle aria-label="{{ 'sections.header.search' | t }}">
          {% render 'icon-search' %}
        </button>
      {%- endif -%}

      <button type="button" class="site-header__icon-btn" data-account-drawer-toggle aria-label="{{ 'sections.header.account' | t }}">
        {% render 'icon-account' %}
      </button>

      {%- if settings.enable_wishlist -%}
        <a href="{{ routes.root_url }}pages/wishlist" class="site-header__icon-btn hide-mobile" data-wishlist-link aria-label="{{ 'sections.header.wishlist' | t }}">
          {% render 'icon-heart' %}
          <span class="site-header__icon-count" data-wishlist-count>0</span>
        </a>
      {%- endif -%}

      <button class="site-header__icon-btn" data-cart-drawer-toggle aria-label="{{ 'sections.header.cart' | t }}" style="display: none !important;">
        {% render 'icon-cart' %}
        {%- assign cart_item_count = 0 -%}
        {%- for item in cart.items -%}
          {%- if item.variant_id == 48862017716468 -%}{%- continue -%}{%- endif -%}
          {%- assign cart_item_count = cart_item_count | plus: item.quantity -%}
        {%- endfor -%}
        <span class="site-header__icon-count" data-cart-count>{{ cart_item_count }}</span>
      </button>
    </div>
  </div>
</header>

<div class="mobile-nav" id="MobileNav" data-mobile-nav aria-hidden="true" style="transform: translateX(-100%); visibility: hidden;">
  <div class="mobile-nav__header">
    <span class="mobile-nav__title">{{ shop.name }}</span>
    <button class="mobile-nav__close" data-mobile-nav-close aria-label="{{ 'accessibility.close' | t }}">
      {% render 'icon-close' %}
    </button>
  </div>
  <ul class="mobile-nav__list" role="list">
    {%- for link in section.settings.main_menu.links -%}
      {%- assign is_catalog = false -%}
      {%- assign check_title = link.title | downcase -%}
      {%- if check_title == 'catalog' or check_title == 'catalogue' or check_title == 'categories' -%}
        {%- assign is_catalog = true -%}
      {%- endif -%}

      {%- if is_catalog -%}
        <li class="mobile-nav__item mobile-nav__item--has-sub">
          <button class="mobile-nav__row-btn" aria-expanded="false" data-mobile-submenu-toggle>
            <span>Categories</span>
            <span class="mobile-nav__arrow">
              {% render 'icon-chevron-down' %}
            </span>
          </button>
          <ul class="mobile-nav__sublist" role="list">

            <!-- Shop All -->
            <li class="mobile-nav__subitem">
              <a href="/collections/all" class="mobile-nav__link mobile-nav__link--shop-all">🛍️ Shop All Products</a>
            </li>

            <!-- Men's Oversized -->
            <li class="mobile-nav__subitem mobile-nav__subitem--has-sub">
              <button class="mobile-nav__row-btn mobile-nav__row-btn--sub" aria-expanded="false" data-mobile-submenu-toggle>
                <span>Men's Oversized</span>
                <span class="mobile-nav__arrow">
                  {% render 'icon-chevron-down' %}
                </span>
              </button>
              <ul class="mobile-nav__sublist mobile-nav__sublist--deep" role="list">
                <li><a href="/collections/men-oversized-graphic-print" class="mobile-nav__link mobile-nav__link--deep">Graphic Print</a></li>
                <li><a href="/collections/men-oversized-anime" class="mobile-nav__link mobile-nav__link--deep">Anime</a></li>
                <li><a href="/collections/men-oversized-streetwear" class="mobile-nav__link mobile-nav__link--deep">Streetwear</a></li>
                <li><a href="/collections/men-oversized-story-wear" class="mobile-nav__link mobile-nav__link--deep">Story Wear</a></li>
                <li><a href="/collections/men-oversized-minimal" class="mobile-nav__link mobile-nav__link--deep">Minimal</a></li>
                <li><a href="/collections/men-oversized-solid-basics" class="mobile-nav__link mobile-nav__link--deep">Solid Basics</a></li>
              </ul>
            </li>

            <!-- Women's Oversized -->
            <li class="mobile-nav__subitem mobile-nav__subitem--has-sub">
              <button class="mobile-nav__row-btn mobile-nav__row-btn--sub" aria-expanded="false" data-mobile-submenu-toggle>
                <span>Women's Oversized</span>
                <span class="mobile-nav__arrow">
                  {% render 'icon-chevron-down' %}
                </span>
              </button>
              <ul class="mobile-nav__sublist mobile-nav__sublist--deep" role="list">
                <li><a href="/collections/women-oversized-graphic-print" class="mobile-nav__link mobile-nav__link--deep">Graphic Print</a></li>
                <li><a href="/collections/women-oversized-anime" class="mobile-nav__link mobile-nav__link--deep">Anime</a></li>
                <li><a href="/collections/women-oversized-streetwear" class="mobile-nav__link mobile-nav__link--deep">Streetwear</a></li>
                <li><a href="/collections/women-oversized-story-wear" class="mobile-nav__link mobile-nav__link--deep">Story Wear</a></li>
                <li><a href="/collections/women-oversized-minimal" class="mobile-nav__link mobile-nav__link--deep">Minimal</a></li>
                <li><a href="/collections/women-oversized-solid-basics" class="mobile-nav__link mobile-nav__link--deep">Solid Basics</a></li>
              </ul>
            </li>

          </ul>
        </li>
      {%- else -%}
        <li class="mobile-nav__item">
          <a href="{{ link.url }}" class="mobile-nav__link">{{ link.title }}</a>
          {%- if link.links.size > 0 -%}
            <button class="mobile-nav__expand" aria-label="Expand {{ link.title }}" data-mobile-submenu-toggle>
              {% render 'icon-chevron-down' %}
            </button>
            <ul class="mobile-nav__sublist" role="list">
              {%- for child_link in link.links -%}
                <li><a href="{{ child_link.url }}">{{ child_link.title }}</a></li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </li>
      {%- endif -%}
    {%- endfor -%}
    
    <li class="mobile-nav__item">
      <a href="/pages/about-us" class="mobile-nav__link">About Us</a>
    </li>
    <li class="mobile-nav__item">
      <a href="/pages/bulk-order" class="mobile-nav__link">Bulk Order</a>
    </li>
    <li class="mobile-nav__item">
      <a href="/blogs/news" class="mobile-nav__link">Blogs</a>
    </li>
    <li class="mobile-nav__item">
      <button type="button" class="mobile-nav__link mobile-nav__link--btn" data-account-drawer-toggle>My Account & VIP Card</button>
    </li>
    {%- if settings.enable_wishlist -%}
      <li class="mobile-nav__item">
        <a href="{{ routes.root_url }}pages/wishlist" class="mobile-nav__link">My Wishlist</a>
      </li>
    {%- endif -%}
  </ul>
</div>
<div class="mobile-nav__overlay" data-mobile-nav-overlay></div>

{%- comment -%} TOKIYO VIP ACCOUNT & MEMBER PRIVILEGE DRAWER {%- endcomment -%}
<div class="account-drawer" id="AccountDrawer" data-account-drawer aria-hidden="true">
  <div class="account-drawer__overlay" data-account-drawer-close></div>
  <div class="account-drawer__inner">
    <div class="account-drawer__header">
      <div class="account-drawer__brand">
        <img src="{{ 'tokiyo-logo.jpeg' | asset_url }}" alt="{{ shop.name }}" width="130" height="auto" loading="eager" class="account-drawer__logo-img">
      </div>
      <button class="account-drawer__close" data-account-drawer-close aria-label="Close Account Drawer">✕</button>
    </div>

    <div class="account-drawer__body">

      {%- if customer -%}
        {%- comment -%} Logged-in Customer View: SHOW VIP PRIVILEGE CARD {%- endcomment -%}
        {%- assign base_timestamp = 'now' | date: '%s' | plus: 0 -%}
        {%- if customer.orders.size > 0 -%}
          {%- assign latest_order_date = customer.orders.first.created_at | date: '%s' | plus: 0 -%}
          {%- assign base_timestamp = latest_order_date -%}
        {%- endif -%}
        {%- assign validity_seconds = 90 | times: 24 | times: 60 | times: 60 -%}
        {%- assign validity_timestamp = base_timestamp | plus: validity_seconds -%}
        
        {%- comment -%} Unique Serialized Card Number from Customer ID {%- endcomment -%}
        {%- assign card_id_raw = customer.id | default: 1001 -%}
        {%- assign card_part1 = card_id_raw | modulo: 8999 | plus: 1000 -%}
        {%- assign card_part2 = card_id_raw | slice: -4, 4 -%}

        <div class="account-drawer__card-section">
          <div class="tokiyo-drawer-card">
            <div class="drawer-card__glow-red"></div>
            <div class="drawer-card__glow-gold"></div>

            <div class="drawer-card__header">
              <div class="drawer-card__brand">
                <span class="drawer-card__title">TOKIYO</span>
                <span class="drawer-card__sub">LIFESTYLE</span>
              </div>
              <span class="drawer-card__badge">BLACK TIER</span>
            </div>

            <div class="drawer-card__chip-row">
              <div class="drawer-card__chip">
                <div class="drawer-card__chip-inner"></div>
              </div>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,0.4)" stroke-width="2" stroke-linecap="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </div>

            <div class="drawer-card__number">
              TK-{{ card_part1 }}-{{ card_part2 }}
            </div>

            <div class="drawer-card__footer">
              <div>
                <span class="drawer-card__lbl">MEMBER NAME</span>
                <span class="drawer-card__val">{{ customer.name | default: 'VIP Member' }}</span>
              </div>
              <div class="text-right">
                <span class="drawer-card__lbl">VALID UNTIL</span>
                <span class="drawer-card__val font-mono">{{ validity_timestamp | date: '%d/%m/%Y' }}</span>
              </div>
            </div>
          </div>

          <div class="drawer-vip-info">
            <span class="drawer-vip-icon">⚡</span>
            <span>Validity auto-extends by <strong>+3 months</strong> on every purchase!</span>
          </div>
        </div>

        <div class="account-drawer__user-box">
          <h3>Welcome, {{ customer.first_name }} 👋</h3>
          <p>{{ customer.email }}</p>
          <div class="account-drawer__actions">
            <a href="{{ routes.account_url }}" class="button button--solid button--full">View My Orders ({{ customer.orders.size }})</a>
            <a href="{{ routes.account_addresses_url }}" class="button button--outline button--full">Manage Addresses</a>
            <a href="https://wa.me/917788847469?text=Hi%20Tokiyo%20Team%2C%20I%20am%20a%20VIP%20Member%20and%20need%20support" target="_blank" rel="noopener" class="account-drawer__whatsapp-btn">
              💬 VIP WhatsApp Support (+91 77888 47469)
            </a>
            <a href="{{ routes.account_logout_url }}" class="button button--outline button--full account-drawer__logout-btn">Log Out</a>
          </div>
        </div>

      {%- else -%}
        <!-- Guest View: Teaser & Quick Login (NO CARD SHOWN) -->
        <div class="account-drawer__guest-teaser">
          <div class="guest-privilege-badge">
            <span class="guest-badge-icon">👑</span>
            <span>Tokiyo VIP Privilege Pass</span>
          </div>
          <p class="guest-teaser-desc">Sign in to unlock your unique <strong>Tokiyo VIP Privilege Card</strong>, exclusive retail partner discounts & priority drop access!</p>
        </div>

        <div class="account-drawer__login-box">
          <h3>Sign In to Your Account</h3>
          <p class="account-drawer__subtitle">Sign in with your email to access your Tokiyo VIP Privilege Card & Order history.</p>

          <a href="{{ routes.account_url }}" class="button button--solid button--full account-drawer__submit-btn">
            Sign In / Access VIP Card →
          </a>

          <div class="account-drawer__links">
            <a href="{{ routes.account_register_url }}" class="account-drawer__link">Create a New Account →</a>
          </div>
        </div>
      {%- endif -%}

    </div>
  </div>
</div>

{% schema %}
{
  "name": "Header",
  "tag": "header",
  "class": "section-header",
  "settings": [
    {
      "type": "link_list",
      "id": "main_menu",
      "label": "Menu",
      "default": "main-menu"
    },
    {
      "type": "checkbox",
      "id": "sticky_header",
      "label": "Enable sticky header",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_search",
      "label": "Enable search icon",
      "default": true
    },
    {
      "type": "header",
      "content": "Mega Menu Feature Image"
    },
    {
      "type": "image_picker",
      "id": "mega_menu_image",
      "label": "Feature image"
    },
    {
      "type": "url",
      "id": "mega_menu_image_link",
      "label": "Feature image link"
    },
    {
      "type": "text",
      "id": "mega_menu_image_caption",
      "label": "Feature image caption",
      "default": "New Season Edit"
    }
  ]
}
{% endschema %}
