{%- comment -%}
  TOKIYO — Trending / New-Arrivals product grid
  • Bestsellers: keeps Shopify's best-selling / click order (no shuffle)
  • Fresh Drops / New Arrivals: JS random-shuffle from newest pool on every refresh
{%- endcomment -%}

{%- assign sort_mode   = section.settings.sort_by  | default: 'auto' -%}
{%- assign title_dn    = section.settings.title    | downcase -%}
{%- assign eyebrow_dn  = section.settings.eyebrow  | downcase -%}

{%- assign is_new_arrivals = false -%}
{%- if sort_mode == 'created_descending' or title_dn contains 'new' or eyebrow_dn contains 'fresh' or eyebrow_dn contains 'new' -%}
  {%- assign is_new_arrivals = true -%}
{%- endif -%}

{%- assign target_handle = section.settings.collection.handle | default: section.settings.collection -%}
{%- if target_handle == blank -%}
  {%- if is_new_arrivals -%}{%- assign target_handle = 'new-arrivals' -%}
  {%- else -%}{%- assign target_handle = 'bestsellers' -%}
  {%- endif -%}
{%- endif -%}

{%- assign target_col      = collections[target_handle] -%}
{%- assign sorted_products = target_col.products -%}

{%- if sorted_products == blank or sorted_products.size == 0 -%}
  {%- if is_new_arrivals -%}
    {%- assign sorted_products = collections['new-arrivals'].products -%}
  {%- else -%}
    {%- assign sorted_products = collections['bestsellers'].products -%}
  {%- endif -%}
  {%- if sorted_products == blank or sorted_products.size == 0 -%}
    {%- assign sorted_products = collections['all'].products -%}
  {%- endif -%}
{%- endif -%}

{%- assign max_limit  = section.settings.limit | default: 8 -%}
{%- assign cta_link   = section.settings.cta_link  | default: '/collections/all' -%}
{%- assign cta_label  = section.settings.cta_label | default: 'Shop All' -%}
{%- assign section_id = section.id -%}

{%- comment -%} Count valid products (exclude COD fee & combo bundles) {%- endcomment -%}
{%- assign valid_count = 0 -%}
{%- for p in sorted_products -%}
  {%- if p.handle != 'cod-fee' and p.type != 'Combo Bundle' -%}
    {%- assign valid_count = valid_count | plus: 1 -%}
  {%- endif -%}
{%- endfor -%}

<section
  class="trending-products section-trending-products"
  id="section-{{ section_id }}"
  data-section-type="{% if is_new_arrivals %}new-arrivals{% else %}bestsellers{% endif %}"
  data-max-limit="{{ max_limit }}"
  data-is-shuffle="{% if is_new_arrivals %}true{% else %}false{% endif %}"
>
  <div class="page-width">

    {%- comment -%} ── Section Header: eyebrow + title left, Shop All pill right ── {%- endcomment -%}
    <div class="tp-header animate-on-scroll fade-up">
      <div class="tp-header__left">
        {%- if section.settings.eyebrow != blank -%}
          <p class="text-eyebrow tp-eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h2 class="tp-title">{{ section.settings.title | default: 'Bestsellers' }}</h2>
      </div>
      <a href="{{ cta_link }}" class="tp-shop-all" aria-label="{{ cta_label }}">
        <span>{{ cta_label }}</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    </div>

    {%- if valid_count > 0 -%}

      {%- if is_new_arrivals -%}
        {%- comment -%}
          FRESH DROPS: render up to 50 cards hidden, JS shuffle picks max_limit to show.
          Every page refresh = a fresh random set.
        {%- endcomment -%}
        <div
          class="product-grid product-grid--{{ section.settings.columns | default: 4 }} tp-grid"
          id="tp-grid-{{ section_id }}"
          data-product-grid
          data-grid-type="new-arrivals"
          data-max-limit="{{ max_limit }}"
          data-shuffle="true"
        >
          {%- assign pool_limit = 50 -%}
          {%- assign rendered = 0 -%}
          {%- for p in sorted_products -%}
            {%- if rendered >= pool_limit -%}{%- break -%}{%- endif -%}
            {%- if p != blank and p.handle != 'cod-fee' and p.type != 'Combo Bundle' -%}
              <div class="tp-pool-card" data-pool-card>
                {% render 'product-card', product: p, lazy: true %}
              </div>
              {%- assign rendered = rendered | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        </div>

      {%- else -%}
        {%- comment -%}
          BESTSELLERS: keep Shopify's click/best-selling sort order — no shuffle.
          Just slice to max_limit.
        {%- endcomment -%}
        <div
          class="product-grid product-grid--{{ section.settings.columns | default: 4 }}"
          data-product-grid
          data-grid-type="bestsellers"
        >
          {%- assign rendered = 0 -%}
          {%- for p in sorted_products -%}
            {%- if rendered >= max_limit -%}{%- break -%}{%- endif -%}
            {%- if p != blank and p.handle != 'cod-fee' and p.type != 'Combo Bundle' -%}
              {% render 'product-card', product: p, lazy: true %}
              {%- assign rendered = rendered | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

    {%- else -%}
      {%- comment -%} Placeholder grid when no products exist yet {%- endcomment -%}
      <div class="product-grid product-grid--{{ section.settings.columns | default: 4 }} stagger-children">
        {%- assign placeholder_products = "Oversized Tee,Cargo Pants,Puffer Jacket,Sneakers,Crossbody Bag,Denim Jacket,Wide Leg Pants,Beanie Cap" | split: "," -%}
        {%- assign placeholder_prices   = "1499,2499,3999,2999,1999,3499,2299,999"   | split: "," -%}
        {%- assign placeholder_compare  = "2499,3999,5999,4499,3499,4999,3499,1499"  | split: "," -%}
        {%- assign placeholder_cats     = "Men's,Men's,Winterwear,Footwear,Accessories,Men's,Women's,Accessories" | split: "," -%}
        {%- for item in placeholder_products limit: max_limit -%}
          <div class="product-card">
            <div class="product-card__media">
              <div class="coming-soon-placeholder">
                <div class="coming-soon-placeholder__inner">
                  <span class="coming-soon-placeholder__icon">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>
                  </span>
                  <span class="coming-soon-placeholder__text">Coming Soon</span>
                </div>
              </div>
            </div>
            <div class="product-card__info">
              <p class="product-card__vendor">{{ placeholder_cats[forloop.index0] }}</p>
              <h3 class="product-card__title">{{ item }}</h3>
              <div class="product-card__price">
                <span class="price--sale">₹{{ placeholder_prices[forloop.index0] }}</span>
                <span class="price--compare">₹{{ placeholder_compare[forloop.index0] }}</span>
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

  </div>
</section>

<style>
  /* ── Section wrapper ── */
  .trending-products {
    padding: var(--spacing-sections, 64px) 0;
    background: var(--color-background, #FFFFFF);
  }
  @media (max-width: 749px) {
    .trending-products { padding: 32px 0; }
  }

  /* ── Header row: title left, Shop All right ── */
  .tp-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 32px;
    flex-wrap: wrap;
  }
  .tp-header__left { flex: 1; min-width: 0; }
  .tp-eyebrow { margin-bottom: 6px; }
  .tp-title {
    font-size: clamp(22px, 3vw, 34px);
    font-weight: 800;
    margin: 0;
    line-height: 1.15;
  }

  /* ── Shop-all pill button ── */
  .tp-shop-all {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    white-space: nowrap;
    padding: 10px 20px;
    border-radius: 999px;
    border: 1.5px solid var(--color-accent, #ff0000);
    color: var(--color-accent, #ff0000);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background 0.22s, color 0.22s, transform 0.22s, box-shadow 0.22s;
    flex-shrink: 0;
  }
  .tp-shop-all:hover {
    background: var(--color-accent, #ff0000);
    color: #fff;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(255,0,0,0.25);
  }
  .tp-shop-all svg { transition: transform 0.2s; }
  .tp-shop-all:hover svg { transform: translateX(4px); }

  /* ── Shuffle pool cards ── */
  .tp-pool-card { display: none; }
  .tp-pool-card.is-visible { display: block; }

  /* ── Placeholder ── */
  .coming-soon-placeholder {
    width:100%; height:100%; aspect-ratio:3/4;
    background: #F4F4F3;
    display:flex; align-items:center; justify-content:center;
    position:relative;
  }
  .coming-soon-placeholder__inner { text-align:center; z-index:1; }
  .coming-soon-placeholder__icon {
    display:block; margin-bottom:0.5rem;
    color: var(--color-accent, #ff0000); opacity:0.6;
  }
  .coming-soon-placeholder__text {
    font-size:0.6875rem; text-transform:uppercase; letter-spacing:0.15em;
    color: var(--color-text-muted, #767674); font-weight:600;
  }
  .product-card__media .badge--new {
    position:absolute; top:12px; left:12px; z-index:2;
  }
</style>

<script>
(function () {
  /* Only shuffle Fresh Drops / new-arrivals grids */
  function initShuffleGrid(section) {
    var grid = section.querySelector('[data-shuffle="true"]');
    if (!grid || grid.dataset.tpInit) return;
    grid.dataset.tpInit = '1';

    var maxLimit = parseInt(section.dataset.maxLimit) || 8;
    var pool     = Array.from(grid.querySelectorAll('[data-pool-card]'));
    if (!pool.length) return;

    /* Fisher-Yates shuffle */
    for (var i = pool.length - 1; i > 0; i--) {
      var j = Math.floor(Math.random() * (i + 1));
      var tmp = pool[i]; pool[i] = pool[j]; pool[j] = tmp;
    }

    /* Show maxLimit, hide rest, re-append in shuffled order */
    pool.forEach(function (card, idx) {
      if (idx < maxLimit) {
        card.classList.add('is-visible');
        card.style.display = '';
        grid.appendChild(card);
      } else {
        card.style.display = 'none';
      }
    });
  }

  function initAll() {
    document.querySelectorAll('.section-trending-products[data-is-shuffle="true"]').forEach(initShuffleGrid);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAll);
  } else {
    initAll();
  }
})();
</script>

{% schema %}
{
  "name": "Trending Products",
  "tag": "section",
  "class": "section-trending-products",
  "settings": [
    { "type": "text",       "id": "eyebrow",    "label": "Eyebrow",            "default": "Trending Now" },
    { "type": "text",       "id": "title",      "label": "Heading",            "default": "Bestsellers" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    {
      "type": "select", "id": "sort_by", "label": "Sort Order",
      "options": [
        { "value": "auto",               "label": "Auto (Shopify default)" },
        { "value": "created_descending", "label": "Newest First (Fresh Drops)" },
        { "value": "best_selling",       "label": "Best Selling / Most Clicks" }
      ],
      "default": "auto"
    },
    { "type": "range", "id": "limit",   "min": 4, "max": 12, "step": 1, "label": "Products to show", "default": 8 },
    { "type": "range", "id": "columns", "min": 2, "max": 5,  "step": 1, "label": "Columns",          "default": 4 },
    { "type": "text", "id": "cta_label", "label": "Shop All button label", "default": "Shop All" },
    { "type": "url",  "id": "cta_link",  "label": "Shop All button link" }
  ],
  "presets": [{ "name": "Trending Products" }]
}
{% endschema %}
