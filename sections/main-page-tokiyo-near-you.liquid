<script>
  let userCoords = null; // { lat, lng }
  let currentRadius = 1; // 1km default

  // Haversine Distance Formula in Kilometers
  function calculateDistance(lat1, lon1, lat2, lon2) {
    const R = 6371; // Earth radius in km
    const dLat = (lat2 - lat1) * Math.PI / 180;
    const dLon = (lon2 - lon1) * Math.PI / 180;
    const a = 
      Math.sin(dLat/2) * Math.sin(dLat/2) +
      Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) * 
      Math.sin(dLon/2) * Math.sin(dLon/2);
    const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
    return R * c;
  }

  // Format distance for UI display
  function formatDistanceDisplay(km) {
    if (km < 1) {
      const meters = Math.round(km * 1000);
      return `🟢 ${meters}m away`;
    }
    return `📍 ${km.toFixed(1)} km away`;
  }

  // GPS Location Detector
  function detectUserLocation() {
    const statusText = document.getElementById('LocationStatusText');
    const radarDot = document.getElementById('RadarDot');
    const gpsBtn = document.getElementById('BtnDetectLocation');

    if (!navigator.geolocation) {
      alert('Geolocation is not supported by your browser.');
      return;
    }

    if (statusText) statusText.textContent = 'Detecting your live GPS location... 🛰️';
    if (gpsBtn) gpsBtn.innerHTML = '<span class="gps-icon">⏳</span> Locating...';

    navigator.geolocation.getCurrentPosition(
      (position) => {
        userCoords = {
          lat: position.coords.latitude,
          lng: position.coords.longitude
        };

        if (statusText) statusText.innerHTML = `✅ <strong>Location Active:</strong> Filtered to spots within <strong>${currentRadius === 'all' ? 'All City' : currentRadius + ' KM'}</strong> of you`;
        if (gpsBtn) gpsBtn.innerHTML = '<span class="gps-icon">✓</span> Location Locked';
        if (radarDot) radarDot.style.background = '#00E676';

        filterPartnerCards();
      },
      (error) => {
        console.warn('Geolocation error:', error);
        // Default to Bhubaneswar Center (Patia)
        userCoords = { lat: 20.3533, lng: 85.8178 };
        if (statusText) statusText.innerHTML = `📍 Showing spots near <strong>Bhubaneswar (Patia)</strong>`;
        if (gpsBtn) gpsBtn.innerHTML = '<span class="gps-icon">📍</span> Area Set';
        filterPartnerCards();
      },
      { enableHighAccuracy: true, timeout: 8000 }
    );
  }

  function setRadius(rad, btn) {
    currentRadius = rad;
    document.querySelectorAll('.radius-pill').forEach(p => p.classList.remove('is-active'));
    if (btn) btn.classList.add('is-active');

    const statusText = document.getElementById('LocationStatusText');
    if (statusText && userCoords) {
      statusText.innerHTML = `✅ Filtered to spots within <strong>${rad === 'all' ? 'All City' : rad + ' KM'}</strong> of your location`;
    }

    filterPartnerCards();
  }

  function filterPartnerCards() {
    const catVal = document.getElementById('TnyCatSelect')?.value || 'all';
    const cards = Array.from(document.querySelectorAll('.tny-card'));
    const grid = document.getElementById('PartnerGrid');
    const emptyBox = document.getElementById('TnyEmpty');
    let visibleCount = 0;

    // Calculate distance and filter
    cards.forEach(card => {
      const cardLat = parseFloat(card.dataset.lat) || 20.3533;
      const cardLng = parseFloat(card.dataset.lng) || 85.8178;
      const cardCat = card.dataset.category || '';
      const distBadge = card.querySelector('[data-distance-display]');

      let distKm = 0;
      if (userCoords) {
        distKm = calculateDistance(userCoords.lat, userCoords.lng, cardLat, cardLng);
        card.dataset.calculatedDist = distKm;
        if (distBadge) distBadge.textContent = formatDistanceDisplay(distKm);
      } else {
        card.dataset.calculatedDist = 0;
        if (distBadge) distBadge.textContent = '📍 Near Area';
      }

      let isMatch = true;
      if (catVal !== 'all' && cardCat !== catVal) isMatch = false;

      if (userCoords && currentRadius !== 'all') {
        const radNum = parseFloat(currentRadius);
        if (distKm > radNum) isMatch = false;
      }

      card.style.display = isMatch ? 'flex' : 'none';
      if (isMatch) visibleCount++;
    });

    // Auto-sort cards by closest distance
    if (userCoords && visibleCount > 1) {
      cards.sort((a, b) => {
        const dA = parseFloat(a.dataset.calculatedDist) || 0;
        const dB = parseFloat(b.dataset.calculatedDist) || 0;
        return dA - dB;
      });
      cards.forEach(c => grid.appendChild(c));
    }

    if (emptyBox) {
      emptyBox.style.display = visibleCount === 0 ? 'block' : 'none';
      const emptyHeading = document.getElementById('TnyEmptyHeading');
      if (emptyHeading) {
        emptyHeading.textContent = currentRadius === 'all' 
          ? 'No Partner Spots Found in this Category' 
          : `No Partner Spots Found Within ${currentRadius} KM`;
      }
    }
  }

  function openClaimModal(name, offer) {
    const modal = document.getElementById('ClaimModal');
    if (name) document.getElementById('ModalPartnerName').innerText = name;
    if (offer) document.getElementById('ModalPartnerOffer').innerText = offer;
    if (modal) {
      modal.classList.add('is-open');
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }
  }

  function closeClaimModal() {
    const modal = document.getElementById('ClaimModal');
    if (modal) {
      modal.classList.remove('is-open');
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }
  }

  function confirmDiscountClaimed() {
    alert('🎉 Discount Verified & Applied! Thank you for using Tokiyo Membership.');
    closeClaimModal();
  }
</script>

