{%- comment -%} Tokiyo Lifestyle — TOKIYO NEAR YOU GPS Partner Directory Section {%- endcomment -%}

<div class="tokiyo-near-you page-width">
  
  <!-- Hero Section -->
  <div class="tny-hero animate-on-scroll fade-up">
    <span class="tny-eyebrow">📍 REAL-TIME LOCAL PARTNER RADAR</span>
    <h1 class="tny-title">Tokiyo Near You</h1>
    <p class="tny-subtitle">
      Find cafes, restaurants, gyms & salons within <strong>1km of your current location</strong> where wearing Tokiyo or showing your <strong>Tokiyo VIP Card</strong> gives you instant 5% to 10% discount!
    </p>
  </div>

  <!-- GPS Location Radar & Distance Filter Controls -->
  <div class="tny-radar-card animate-on-scroll fade-up">
    <div class="tny-radar-header">
      <div class="tny-radar-status">
        <span class="radar-dot" id="RadarDot"></span>
        <span id="LocationStatusText">Tap below to detect partner spots within 1 KM of your live location</span>
      </div>
      <button type="button" class="tny-gps-btn" id="BtnDetectLocation" onclick="detectUserLocation()">
        <span class="gps-icon">🎯</span>
        <span>Find Spots Near Me (GPS)</span>
      </button>
    </div>

    <div class="tny-controls-row">
      <!-- Radius Filter Pills -->
      <div class="tny-radius-filter">
        <label>Distance Radius:</label>
        <div class="radius-pills">
          <button type="button" class="radius-pill is-active" data-radius="1" onclick="setRadius(1, this)">Within 1 KM</button>
          <button type="button" class="radius-pill" data-radius="3" onclick="setRadius(3, this)">Within 3 KM</button>
          <button type="button" class="radius-pill" data-radius="5" onclick="setRadius(5, this)">Within 5 KM</button>
          <button type="button" class="radius-pill" data-radius="10" onclick="setRadius(10, this)">Within 10 KM</button>
          <button type="button" class="radius-pill" data-radius="all" onclick="setRadius('all', this)">All Spots</button>
        </div>
      </div>

      <!-- Category Filter -->
      <div class="tny-cat-filter">
        <label for="TnyCatSelect">Category:</label>
        <select id="TnyCatSelect" onchange="filterPartnerCards()">
          <option value="all">All Categories</option>
          <option value="Cafe">☕ Cafes & Bistros</option>
          <option value="Restaurant">🍽️ Restaurants & Dining</option>
          <option value="Gym">🏋️ Gyms & Fitness</option>
          <option value="Salon">✂️ Salons & Grooming</option>
          <option value="Retail">🛍️ Shopping & Lifestyle</option>
        </select>
      </div>
    </div>
  </div>

  <!-- Dynamic Partner Cards Grid (Populated via Blocks / Onboarding) -->
  <div class="tny-grid" id="PartnerGrid">
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        <div class="tny-card"
          data-lat="{{ block.settings.lat | default: '20.3533' }}"
          data-lng="{{ block.settings.lng | default: '85.8178' }}"
          data-locality="{{ block.settings.locality | escape }}"
          data-category="{{ block.settings.category }}"
          {{ block.shopify_attributes }}>
          <div class="tny-card__badge">{{ block.settings.offer_badge | default: '5% OFF MEMBER BENEFIT' }}</div>
          {%- if block.settings.image != blank -%}
            <div class="tny-card__img" style="background-image: url('{{ block.settings.image | image_url: width: 600 }}');"></div>
          {%- else -%}
            <div class="tny-card__img" style="background-image: url('https://images.unsplash.com/photo-1554118811-1e0d58224f24?auto=format&fit=crop&w=600&q=80');"></div>
          {%- endif -%}
          <div class="tny-card__body">
            <div class="tny-card__header-row">
              <span class="tny-card__cat">{{ block.settings.category_icon }} {{ block.settings.category_title }}</span>
              <span class="tny-distance-badge" data-distance-display>📍 Calculating...</span>
            </div>
            <h3 class="tny-card__name">{{ block.settings.title }}</h3>
            <p class="tny-card__address">📍 {{ block.settings.address }}</p>
            <div class="tny-card__meta">
              <span>🕒 {{ block.settings.timings | default: '10:00 AM – 10:30 PM' }}</span>
              <span class="tny-card__offer-tag">{{ block.settings.offer_text | default: '5% Instant Member Discount' }}</span>
            </div>
            <div class="tny-card__actions">
              <a href="{{ block.settings.maps_url | default: 'https://maps.google.com' }}" target="_blank" rel="noopener" class="tny-btn tny-btn--outline">Get Directions 🗺️</a>
              <button type="button" class="tny-btn tny-btn--solid" onclick="openClaimModal('{{ block.settings.title | escape }}', '{{ block.settings.offer_text | escape }}')">Claim 5% OFF ⚡</button>
            </div>
          </div>
        </div>
      {%- endfor -%}
    {%- endif -%}
  </div>

  <!-- Empty 1KM Radius / No Results Box -->
  <div id="TnyEmpty" class="tny-empty" style="display: none;">
    <div class="tny-empty-icon">📍</div>
    <h3 id="TnyEmptyHeading">No Partner Spots Found Within 1 KM</h3>
    <p id="TnyEmptyDesc">
      We are actively onboarding top cafes, gyms & restaurants in this specific radius. You can expand your radius to <strong>3 KM / 5 KM</strong> or recommend your favorite local spot to get discounts!
    </p>
    <div class="tny-empty-actions">
      <button type="button" class="tny-btn tny-btn--outline" onclick="setRadius(5, document.querySelector('[data-radius=\'5\']'))">Expand to 5 KM Radius 🔍</button>
      <a href="/pages/partner-with-us" class="tny-btn tny-btn--solid">Recommend a Spot to Partner →</a>
    </div>
  </div>

  <!-- Onboarding & Launching Information Card -->
  <div class="tny-launch-card animate-on-scroll fade-up">
    <div class="tny-launch-card__inner">
      <div class="tny-launch-badge">
        <span class="pulse-dot"></span>
        <span>EXPANDING LOCAL NETWORK</span>
      </div>
      <h2>Local Partner Network Launching Across Bhubaneswar & Odisha 🚀</h2>
      <p>
        We are onboarding verified youth-favorite spots across <strong>Patia, KIIT Square, Infocity, Saheed Nagar, Jaydev Vihar & Cuttack</strong>. New partner locations are added each week!
      </p>

      <div class="tny-launch-categories">
        <div class="tny-cat-pill">
          <span class="cat-icon">☕</span>
          <span class="cat-title">Cafes & Bistros</span>
          <span class="cat-perk">5% OFF Total Bill</span>
        </div>
        <div class="tny-cat-pill">
          <span class="cat-icon">🍽️</span>
          <span class="cat-title">Restaurants & Lounges</span>
          <span class="cat-perk">5% OFF Dine-in</span>
        </div>
        <div class="tny-cat-pill">
          <span class="cat-icon">🏋️</span>
          <span class="cat-title">Gyms & Fitness</span>
          <span class="cat-perk">10% OFF Passes</span>
        </div>
        <div class="tny-cat-pill">
          <span class="cat-icon">✂️</span>
          <span class="cat-title">Salons & Grooming</span>
          <span class="cat-perk">5% OFF Services</span>
        </div>
        <div class="tny-cat-pill">
          <span class="cat-icon">🛍️</span>
          <span class="cat-title">Lifestyle & Retail</span>
          <span class="cat-perk">5% OFF Purchases</span>
        </div>
      </div>

      <div class="tny-launch-actions">
        <a href="/pages/partner-with-us" class="tny-btn tny-btn--solid tny-btn--large">
          🤝 Own a Business? Partner With Tokiyo →
        </a>
        <a href="/pages/vip-membership-guide" class="tny-btn tny-btn--outline tny-btn--large">
          👑 View VIP Membership Rules
        </a>
      </div>
    </div>
  </div>

  <!-- How It Works Section -->
  <div class="tny-how-it-works animate-on-scroll fade-up">
    <div class="tny-section-header">
      <span class="tny-sub-eyebrow">SIMPLE 3-STEP PROCESS</span>
      <h2>How Tokiyo Near You Works</h2>
    </div>

    <div class="tny-steps-grid">
      <div class="tny-step-card">
        <div class="step-num">01</div>
        <div class="step-icon">📍</div>
        <h3>Detect or Search Spots</h3>
        <p>Enable GPS location to find spots within 1km or search partner cafes, restaurants & gyms near your area.</p>
      </div>

      <div class="tny-step-card">
        <div class="step-num">02</div>
        <div class="step-icon">👑</div>
        <h3>Show Card or Wear Tokiyo</h3>
        <p>Show your digital/physical <strong>Tokiyo VIP Card</strong> or simply wear your Tokiyo streetwear at the billing counter.</p>
      </div>

      <div class="tny-step-card">
        <div class="step-num">03</div>
        <div class="step-icon">⚡</div>
        <h3>Instant 5% Discount</h3>
        <p>The partner applies your 5% member discount on the spot. No complicated points or coupons needed!</p>
      </div>
    </div>
  </div>

  <!-- B2B Partner Recruitment Banner -->
  <div class="tny-partner-cta animate-on-scroll fade-up">
    <div class="tny-partner-cta__content">
      <span class="tny-partner-cta__tag">FOR BUSINESS OWNERS</span>
      <h2>Want to attract young fashion lovers to your spot?</h2>
      <p>
        Partner with Tokiyo Lifestyle with <strong>zero upfront cost</strong>. We list your brand on our app & website, drive loyal foot traffic of college students & youth, and feature you in our local marketing campaigns.
      </p>
      <a href="/pages/partner-with-us" class="tny-btn tny-btn--solid" style="background:#FFFFFF; color:#111111; font-weight:800;">
        Apply For Brand Partnership →
      </a>
    </div>
  </div>

</div>

<!-- Claim Benefit Modal -->
<div class="tny-modal" id="ClaimModal" aria-hidden="true">
  <div class="tny-modal__backdrop" onclick="closeClaimModal()"></div>
  <div class="tny-modal__card">
    <button class="tny-modal__close" onclick="closeClaimModal()">✕</button>
    <div class="tny-modal__header">
      <span class="tny-modal__tag">TOKIYO VIP VERIFICATION</span>
      <h2 id="ModalPartnerName">Tokiyo Member Verification</h2>
      <p id="ModalPartnerOffer">5% Instant Discount for Active Members</p>
    </div>

    <div class="tny-verification-pass">
      <div class="pass-status">
        <span class="status-dot"></span>
        <span>TOKIYO MEMBER: <strong>ACTIVE</strong></span>
      </div>
      <div class="pass-qr">
        <svg width="120" height="120" viewBox="0 0 100 100" fill="#111111">
          <rect x="10" y="10" width="25" height="25" fill="#111"/>
          <rect x="15" y="15" width="15" height="15" fill="#fff"/>
          <rect x="18" y="18" width="9" height="9" fill="#111"/>
          <rect x="65" y="10" width="25" height="25" fill="#111"/>
          <rect x="70" y="15" width="15" height="15" fill="#fff"/>
          <rect x="73" y="18" width="9" height="9" fill="#111"/>
          <rect x="10" y="65" width="25" height="25" fill="#111"/>
          <rect x="15" y="70" width="15" height="15" fill="#fff"/>
          <rect x="18" y="73" width="9" height="9" fill="#111"/>
          <rect x="40" y="10" width="15" height="10"/>
          <rect x="45" y="25" width="15" height="15"/>
          <rect x="65" y="45" width="25" height="10"/>
          <rect x="40" y="65" width="20" height="20"/>
          <rect x="65" y="65" width="15" height="25"/>
        </svg>
      </div>
      <div class="pass-details">
        <p><strong>Member ID:</strong> <span class="font-mono">TKL-{{ customer.id | default: '889201' }}</span></p>
        <p><strong>Name:</strong> {{ customer.name | default: 'VIP Member' }}</p>
        <p><strong>Valid Until:</strong> <span class="font-mono">{{ 'now' | date: '%s' | plus: 15552000 | date: '%d/%m/%Y' }}</span></p>
      </div>
    </div>

    <div class="tny-modal__footer">
      <p class="tny-instruction">Show this QR code / Member Pass to the billing cashier at checkout to claim your instant discount.</p>
      <button class="tny-btn tny-btn--solid tny-btn--full" onclick="confirmDiscountClaimed()">Mark Discount Applied ✓</button>
    </div>
  </div>
</div>

<style>
  .tokiyo-near-you {
    padding-block: 3.5rem 5rem;
  }
  .tny-hero {
    text-align: center;
    max-width: 780px;
    margin-inline: auto;
    margin-bottom: 2.5rem;
  }
  .tny-eyebrow {
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    color: var(--color-accent, #ff0000);
    background: rgba(255,0,0,0.08);
    padding: 0.35rem 1rem;
    border-radius: 50px;
    display: inline-block;
    margin-bottom: 0.75rem;
  }
  .tny-title {
    font-family: 'Outfit', sans-serif;
    font-size: clamp(2.2rem, 4vw, 3.4rem);
    font-weight: 900;
    color: #111111;
    margin-bottom: 0.85rem;
    line-height: 1.15;
  }
  .tny-subtitle {
    font-size: 1.05rem;
    color: #555555;
    line-height: 1.6;
  }

  /* GPS Location Radar Card */
  .tny-radar-card {
    background: #FFFFFF;
    border: 1px solid rgba(0,0,0,0.08);
    box-shadow: 0 12px 35px rgba(0,0,0,0.04);
    border-radius: 20px;
    padding: 1.5rem 2rem;
    margin-bottom: 3rem;
  }
  .tny-radar-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid rgba(0,0,0,0.06);
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
  }
  .tny-radar-status {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.88rem;
    font-weight: 600;
    color: #333333;
  }
  .radar-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #00E676;
    box-shadow: 0 0 10px #00E676;
    animation: radarPulse 1.8s infinite;
  }
  @keyframes radarPulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.3; transform: scale(0.6); }
  }
  .tny-gps-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: #111111;
    color: #FFFFFF;
    border: none;
    padding: 0.75rem 1.4rem;
    border-radius: 50px;
    font-size: 0.85rem;
    font-weight: 800;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .tny-gps-btn:hover {
    background: var(--color-accent, #ff0000);
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(255,0,0,0.25);
  }
  .gps-icon {
    font-size: 1.1rem;
  }

  /* Controls Row */
  .tny-controls-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .tny-radius-filter {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    flex-wrap: wrap;
  }
  .tny-radius-filter label,
  .tny-cat-filter label {
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #666666;
  }
  .radius-pills {
    display: flex;
    gap: 0.45rem;
    flex-wrap: wrap;
  }
  .radius-pill {
    background: #F4F4F6;
    border: 1px solid rgba(0,0,0,0.06);
    border-radius: 50px;
    padding: 0.45rem 0.9rem;
    font-size: 0.78rem;
    font-weight: 700;
    color: #444444;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .radius-pill:hover {
    border-color: #111111;
    color: #111111;
  }
  .radius-pill.is-active {
    background: #111111;
    color: #FFFFFF;
    border-color: #111111;
  }
  .tny-cat-filter {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .tny-cat-filter select {
    padding: 0.45rem 1rem;
    border-radius: 50px;
    border: 1px solid rgba(0,0,0,0.12);
    font-size: 0.8rem;
    font-weight: 700;
    background: #FFFFFF;
    cursor: pointer;
  }

  /* Grid & Cards */
  .tny-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.75rem;
    margin-bottom: 4rem;
  }
  .tny-card {
    background: #FFFFFF;
    border: 1px solid rgba(0,0,0,0.08);
    border-radius: 20px;
    overflow: hidden;
    position: relative;
    display: flex;
    flex-direction: column;
    box-shadow: 0 10px 30px rgba(0,0,0,0.03);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .tny-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 15px 40px rgba(0,0,0,0.08);
  }
  .tny-card__badge {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 2;
    background: rgba(17,17,17,0.85);
    backdrop-filter: blur(4px);
    color: #FFFFFF;
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    padding: 0.3rem 0.65rem;
    border-radius: 50px;
  }
  .tny-card__img {
    aspect-ratio: 16/10;
    background-size: cover;
    background-position: center;
    background-color: #EEEEEE;
  }
  .tny-card__body {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .tny-card__header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.4rem;
  }
  .tny-card__cat {
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-accent, #ff0000);
  }
  .tny-distance-badge {
    font-size: 0.72rem;
    font-weight: 700;
    color: #15803d;
    background: rgba(34,197,94,0.1);
    padding: 0.2rem 0.55rem;
    border-radius: 50px;
  }
  .tny-card__name {
    font-size: 1.25rem;
    font-weight: 800;
    color: #111111;
    margin: 0 0 0.35rem;
  }
  .tny-card__address {
    font-size: 0.85rem;
    color: #666666;
    margin: 0 0 1rem;
    line-height: 1.4;
  }
  .tny-card__meta {
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid rgba(0,0,0,0.06);
    margin-bottom: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-size: 0.8rem;
    color: #555555;
  }
  .tny-card__offer-tag {
    font-weight: 800;
    color: var(--color-accent, #ff0000);
  }
  .tny-card__actions {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 0.6rem;
  }

  /* Empty Box */
  .tny-empty {
    text-align: center;
    padding: 4rem 2rem;
    background: #FFFFFF;
    border: 1px dashed rgba(0,0,0,0.15);
    border-radius: 24px;
    margin-bottom: 4rem;
  }
  .tny-empty-icon {
    font-size: 3rem;
    margin-bottom: 1rem;
  }
  .tny-empty h3 {
    font-size: 1.5rem;
    font-weight: 800;
    margin-bottom: 0.75rem;
  }
  .tny-empty p {
    color: #666666;
    max-width: 540px;
    margin-inline: auto;
    line-height: 1.6;
    margin-bottom: 1.75rem;
  }
  .tny-empty-actions {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  /* Launch Card */
  .tny-launch-card {
    background: #FFFFFF;
    border: 1px solid rgba(0,0,0,0.08);
    box-shadow: 0 15px 45px rgba(0,0,0,0.05);
    border-radius: 24px;
    padding: 3.5rem 2.5rem;
    text-align: center;
    margin-bottom: 4rem;
    position: relative;
    overflow: hidden;
  }
  .tny-launch-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 6px;
    background: linear-gradient(90deg, #ff0000, #ff5e62, #ff9966);
  }
  .tny-launch-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(34,197,94,0.1);
    border: 1px solid rgba(34,197,94,0.25);
    padding: 0.4rem 1rem;
    border-radius: 50px;
    font-size: 0.75rem;
    font-weight: 800;
    color: #15803d;
    margin-bottom: 1.25rem;
    letter-spacing: 0.08em;
  }
  .pulse-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 8px #22c55e;
    animation: tnyPulse 1.8s infinite;
  }
  @keyframes tnyPulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.7); }
  }
  .tny-launch-card h2 {
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    font-weight: 900;
    color: #111111;
    margin-bottom: 1rem;
  }
  .tny-launch-card p {
    font-size: 1rem;
    color: #666666;
    max-width: 680px;
    margin-inline: auto;
    line-height: 1.65;
    margin-bottom: 2.5rem;
  }
  .tny-launch-categories {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1rem;
    margin-bottom: 2.5rem;
  }
  .tny-cat-pill {
    background: #F9F9F9;
    border: 1px solid rgba(0,0,0,0.06);
    border-radius: 16px;
    padding: 1.25rem 1rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .tny-cat-pill:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 20px rgba(0,0,0,0.06);
    border-color: rgba(255,0,0,0.2);
  }
  .cat-icon {
    font-size: 1.8rem;
    margin-bottom: 0.2rem;
  }
  .cat-title {
    font-size: 0.88rem;
    font-weight: 800;
    color: #111111;
  }
  .cat-perk {
    font-size: 0.72rem;
    font-weight: 700;
