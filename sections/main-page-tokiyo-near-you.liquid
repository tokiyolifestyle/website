{%- comment -%} Tokiyo Lifestyle — TOKIYO NEAR YOU Partner Directory Section {%- endcomment -%}

<div class="tokiyo-near-you page-width">
  
  <!-- Hero Section -->
  <div class="tny-hero animate-on-scroll fade-up">
    <span class="tny-eyebrow">📍 TOKIYO LOCAL PARTNER NETWORK</span>
    <h1 class="tny-title">Tokiyo Near You</h1>
    <p class="tny-subtitle">
      We are actively partnering with top cafes, restaurants, gyms, salons & youth-favorite spots across Bhubaneswar, Odisha & beyond. Wearing Tokiyo or showing your <strong>Tokiyo VIP Card</strong> will unlock exclusive 5% instant discounts at partner locations!
    </p>
  </div>

  <!-- Partner Network Launching Soon & Onboarding Box -->
  <div class="tny-launch-card animate-on-scroll fade-up">
    <div class="tny-launch-card__inner">
      <div class="tny-launch-badge">
        <span class="pulse-dot"></span>
        <span>ONBOARDING PARTNER BUSINESSES</span>
      </div>
      <h2>Local Partner Network Launching Soon! 🚀</h2>
      <p>
        We are currently curating and verifying verified local brand partnerships in <strong>Bhubaneswar (Patia, KIIT, Saheed Nagar, Jaydev Vihar)</strong> and surrounding cities. Verified partner spots will appear right here with location maps and instant discount vouchers.
      </p>

      <div class="tny-launch-categories">
        <div class="tny-cat-pill">
          <span class="cat-icon">☕</span>
          <span class="cat-title">Cafes & Bistros</span>
          <span class="cat-perk">5% OFF Total Bill</span>
        </div>
        <div class="tny-cat-pill">
          <span class="cat-icon">🍽️</span>
          <span class="cat-title">Restaurants & Lounges</span>
          <span class="cat-perk">5% OFF Dine-in</span>
        </div>
        <div class="tny-cat-pill">
          <span class="cat-icon">🏋️</span>
          <span class="cat-title">Gyms & Fitness</span>
          <span class="cat-perk">10% OFF Passes</span>
        </div>
        <div class="tny-cat-pill">
          <span class="cat-icon">✂️</span>
          <span class="cat-title">Salons & Grooming</span>
          <span class="cat-perk">5% OFF Services</span>
        </div>
        <div class="tny-cat-pill">
          <span class="cat-icon">🛍️</span>
          <span class="cat-title">Lifestyle & Retail</span>
          <span class="cat-perk">5% OFF Purchases</span>
        </div>
      </div>

      <!-- Call To Action Buttons -->
      <div class="tny-launch-actions">
        <a href="/pages/partner-with-us" class="tny-btn tny-btn--solid tny-btn--large">
          🤝 Own a Business? Partner With Tokiyo →
        </a>
        <a href="/pages/vip-membership-guide" class="tny-btn tny-btn--outline tny-btn--large">
          👑 View VIP Membership Rules
        </a>
      </div>
    </div>
  </div>

  <!-- How It Works Section -->
  <div class="tny-how-it-works animate-on-scroll fade-up">
    <div class="tny-section-header">
      <span class="tny-sub-eyebrow">SIMPLE 3-STEP PROCESS</span>
      <h2>How Tokiyo Near You Works</h2>
    </div>

    <div class="tny-steps-grid">
      <div class="tny-step-card">
        <div class="step-num">01</div>
        <div class="step-icon">📍</div>
        <h3>Find a Partner Spot</h3>
        <p>Browse our directory or look for the <strong>"Tokiyo Partner"</strong> badge at cafes, restaurants, gyms & shops in your city.</p>
      </div>

      <div class="tny-step-card">
        <div class="step-num">02</div>
        <div class="step-icon">👑</div>
        <h3>Show Card or Wear Tokiyo</h3>
        <p>Show your digital/physical <strong>Tokiyo VIP Card</strong> or simply wear your Tokiyo streetwear at the billing counter.</p>
      </div>

      <div class="tny-step-card">
        <div class="step-num">03</div>
        <div class="step-icon">⚡</div>
        <h3>Instant 5% Discount</h3>
        <p>The partner applies your 5% member discount on the spot. No complicated points or coupons needed!</p>
      </div>
    </div>
  </div>

  <!-- B2B Partner Recruitment Banner -->
  <div class="tny-partner-cta animate-on-scroll fade-up">
    <div class="tny-partner-cta__content">
      <span class="tny-partner-cta__tag">FOR BUSINESS OWNERS</span>
      <h2>Want to attract young fashion lovers to your spot?</h2>
      <p>
        Partner with Tokiyo Lifestyle with <strong>zero upfront cost</strong>. We list your brand on our app & website, drive loyal foot traffic of college students & youth, and feature you in our local marketing campaigns.
      </p>
      <a href="/pages/partner-with-us" class="tny-btn tny-btn--solid" style="background:#FFFFFF; color:#111111; font-weight:800;">
        Apply For Brand Partnership →
      </a>
    </div>
  </div>

</div>

<!-- Claim Benefit Modal -->
<div class="tny-modal" id="ClaimModal" aria-hidden="true">
  <div class="tny-modal__backdrop" onclick="closeClaimModal()"></div>
  <div class="tny-modal__card">
    <button class="tny-modal__close" onclick="closeClaimModal()">✕</button>
    <div class="tny-modal__header">
      <span class="tny-modal__tag">TOKIYO VIP VERIFICATION</span>
      <h2 id="ModalPartnerName">Tokiyo Member Verification</h2>
      <p id="ModalPartnerOffer">5% Instant Discount for Active Members</p>
    </div>

    <div class="tny-verification-pass">
      <div class="pass-status">
        <span class="status-dot"></span>
        <span>TOKIYO MEMBER: <strong>ACTIVE</strong></span>
      </div>
      <div class="pass-qr">
        <svg width="120" height="120" viewBox="0 0 100 100" fill="#111111">
          <rect x="10" y="10" width="25" height="25" fill="#111"/>
          <rect x="15" y="15" width="15" height="15" fill="#fff"/>
          <rect x="18" y="18" width="9" height="9" fill="#111"/>
          
          <rect x="65" y="10" width="25" height="25" fill="#111"/>
          <rect x="70" y="15" width="15" height="15" fill="#fff"/>
          <rect x="73" y="18" width="9" height="9" fill="#111"/>
          
          <rect x="10" y="65" width="25" height="25" fill="#111"/>
          <rect x="15" y="70" width="15" height="15" fill="#fff"/>
          <rect x="18" y="73" width="9" height="9" fill="#111"/>

          <rect x="40" y="10" width="15" height="10"/>
          <rect x="45" y="25" width="15" height="15"/>
          <rect x="65" y="45" width="25" height="10"/>
          <rect x="40" y="65" width="20" height="20"/>
          <rect x="65" y="65" width="15" height="25"/>
        </svg>
      </div>
      <div class="pass-details">
        <p><strong>Member ID:</strong> <span class="font-mono">TKL-{{ customer.id | default: '889201' }}</span></p>
        <p><strong>Name:</strong> {{ customer.name | default: 'VIP Member' }}</p>
        <p><strong>Valid Until:</strong> <span class="font-mono">{{ 'now' | date: '%s' | plus: 15552000 | date: '%d/%m/%Y' }}</span></p>
      </div>
    </div>

    <div class="tny-modal__footer">
      <p class="tny-instruction">Show this QR code / Member Pass to the billing cashier at checkout to claim your instant discount.</p>
      <button class="tny-btn tny-btn--solid tny-btn--full" onclick="confirmDiscountClaimed()">Mark Discount Applied ✓</button>
    </div>
  </div>
</div>

<style>
  .tokiyo-near-you {
    padding-block: 3.5rem 5rem;
  }
  .tny-hero {
    text-align: center;
    max-width: 780px;
    margin-inline: auto;
    margin-bottom: 3rem;
  }
  .tny-eyebrow {
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    color: var(--color-accent, #ff0000);
    background: rgba(255,0,0,0.08);
    padding: 0.35rem 1rem;
    border-radius: 50px;
    display: inline-block;
    margin-bottom: 0.75rem;
  }
  .tny-title {
    font-family: 'Outfit', sans-serif;
    font-size: clamp(2.2rem, 4vw, 3.4rem);
    font-weight: 900;
    color: #111111;
    margin-bottom: 0.85rem;
    line-height: 1.15;
  }
  .tny-subtitle {
    font-size: 1.05rem;
    color: #555555;
    line-height: 1.6;
  }

  /* Launching Soon Card */
  .tny-launch-card {
    background: #FFFFFF;
    border: 1px solid rgba(0,0,0,0.08);
    box-shadow: 0 15px 45px rgba(0,0,0,0.05);
    border-radius: 24px;
    padding: 3.5rem 2.5rem;
    text-align: center;
    margin-bottom: 4rem;
    position: relative;
    overflow: hidden;
  }
  .tny-launch-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 6px;
    background: linear-gradient(90deg, #ff0000, #ff5e62, #ff9966);
  }
  .tny-launch-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(34,197,94,0.1);
    border: 1px solid rgba(34,197,94,0.25);
    padding: 0.4rem 1rem;
    border-radius: 50px;
    font-size: 0.75rem;
    font-weight: 800;
    color: #15803d;
    margin-bottom: 1.25rem;
    letter-spacing: 0.08em;
  }
  .pulse-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 8px #22c55e;
    animation: tnyPulse 1.8s infinite;
  }
  @keyframes tnyPulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.7); }
  }
  .tny-launch-card h2 {
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    font-weight: 900;
    color: #111111;
    margin-bottom: 1rem;
  }
  .tny-launch-card p {
    font-size: 1rem;
    color: #666666;
    max-width: 680px;
    margin-inline: auto;
    line-height: 1.65;
    margin-bottom: 2.5rem;
  }

  /* Category Pills */
  .tny-launch-categories {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1rem;
    margin-bottom: 2.5rem;
  }
  .tny-cat-pill {
    background: #F9F9F9;
    border: 1px solid rgba(0,0,0,0.06);
    border-radius: 16px;
    padding: 1.25rem 1rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .tny-cat-pill:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 20px rgba(0,0,0,0.06);
    border-color: rgba(255,0,0,0.2);
  }
  .cat-icon {
    font-size: 1.8rem;
    margin-bottom: 0.2rem;
  }
  .cat-title {
    font-size: 0.88rem;
    font-weight: 800;
    color: #111111;
  }
  .cat-perk {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--color-accent, #ff0000);
    background: rgba(255,0,0,0.06);
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
  }

  /* Actions */
  .tny-launch-actions {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  /* Buttons */
  .tny-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.85rem 1.6rem;
    font-size: 0.85rem;
    font-weight: 700;
    border-radius: 50px;
    text-decoration: none;
    cursor: pointer;
    border: none;
    transition: all 0.3s ease;
  }
  .tny-btn--large {
    padding: 1rem 2rem;
    font-size: 0.92rem;
  }
  .tny-btn--solid {
    background: #111111;
    color: #FFFFFF;
  }
  .tny-btn--solid:hover {
    background: var(--color-accent, #ff0000);
    color: #FFFFFF;
    transform: translateY(-2px);
    box-shadow: 0 10px 25px rgba(255,0,0,0.25);
  }
  .tny-btn--outline {
    background: transparent;
    color: #111111;
    border: 1.5px solid rgba(0,0,0,0.2);
  }
  .tny-btn--outline:hover {
    border-color: #111111;
    background: #111111;
    color: #FFFFFF;
  }
  .tny-btn--full {
    width: 100%;
  }

  /* How it works */
  .tny-how-it-works {
    margin-bottom: 4rem;
  }
  .tny-section-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }
  .tny-sub-eyebrow {
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.15em;
    color: #777777;
    display: block;
    margin-bottom: 0.4rem;
  }
  .tny-section-header h2 {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: 900;
    color: #111111;
  }
  .tny-steps-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }
  .tny-step-card {
    background: #FFFFFF;
    border: 1px solid rgba(0,0,0,0.08);
    border-radius: 20px;
    padding: 2.25rem 1.75rem;
    position: relative;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .tny-step-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 30px rgba(0,0,0,0.06);
  }
  .step-num {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    font-size: 1.6rem;
    font-weight: 900;
    color: rgba(0,0,0,0.06);
    font-family: 'Outfit', sans-serif;
  }
  .step-icon {
    font-size: 2.2rem;
    margin-bottom: 1rem;
  }
  .tny-step-card h3 {
    font-size: 1.15rem;
    font-weight: 800;
    color: #111111;
    margin-bottom: 0.5rem;
  }
  .tny-step-card p {
    font-size: 0.9rem;
    color: #666666;
    line-height: 1.55;
    margin: 0;
  }

  /* Partner CTA Banner */
  .tny-partner-cta {
    background: linear-gradient(135deg, #111111 0%, #1f1f1f 100%);
    color: #FFFFFF;
    border-radius: 24px;
    padding: 3.5rem 2.5rem;
    text-align: center;
    box-shadow: 0 20px 50px rgba(0,0,0,0.15);
  }
  .tny-partner-cta__content {
    max-width: 680px;
    margin-inline: auto;
  }
  .tny-partner-cta__tag {
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    color: var(--color-accent, #ff0000);
    display: inline-block;
    margin-bottom: 0.75rem;
  }
  .tny-partner-cta h2 {
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    font-weight: 900;
    color: #FFFFFF;
    margin-bottom: 1rem;
  }
  .tny-partner-cta p {
    font-size: 0.95rem;
    color: rgba(255,255,255,0.75);
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  /* Modal */
  .tny-modal {
    position: fixed;
    inset: 0;
    z-index: 999999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }
  .tny-modal.is-open {
    opacity: 1;
    visibility: visible;
  }
  .tny-modal__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0.7);
    backdrop-filter: blur(8px);
  }
  .tny-modal__card {
    background: #FFFFFF;
    border-radius: 24px;
    max-width: 440px;
    width: 100%;
    padding: 2.25rem 1.75rem;
    position: relative;
    z-index: 2;
    text-align: center;
    box-shadow: 0 25px 60px rgba(0,0,0,0.25);
  }
  .tny-modal__close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: none;
    border: none;
    font-size: 1.25rem;
    cursor: pointer;
    color: #888888;
  }
  .tny-modal__tag {
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.15em;
    color: var(--color-accent, #ff0000);
    display: block;
    margin-bottom: 0.35rem;
  }
  .tny-modal__header h2 {
    font-size: 1.4rem;
    font-weight: 800;
    margin: 0 0 0.25rem;
  }
  .tny-modal__header p {
    font-size: 0.85rem;
    color: #0F52BA;
    font-weight: 700;
    margin-bottom: 1.5rem;
  }
  .tny-verification-pass {
    background: #111111;
    color: #FFFFFF;
    border-radius: 16px;
    padding: 1.5rem 1rem;
    margin-bottom: 1.5rem;
    box-shadow: 0 10px 25px rgba(0,0,0,0.2);
  }
  .pass-status {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    margin-bottom: 1rem;
  }
  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #00E676;
    box-shadow: 0 0 10px #00E676;
  }
  .pass-qr {
    background: #FFFFFF;
    padding: 0.85rem;
    border-radius: 12px;
    display: inline-block;
    margin-bottom: 1rem;
  }
  .pass-details p {
    font-size: 0.8rem;
    margin-bottom: 0.25rem;
    color: rgba(255,255,255,0.8);
  }
  .tny-instruction {
    font-size: 0.75rem;
    color: #666666;
    margin-bottom: 1rem;
    line-height: 1.4;
  }

  /* Responsive */
  @media (max-width: 850px) {
    .tny-steps-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
    .tny-launch-card {
      padding: 2.25rem 1.25rem;
    }
    .tny-launch-actions {
      flex-direction: column;
    }
    .tny-btn--large {
      width: 100%;
    }
  }
</style>

<script>
  function openClaimModal(name, offer) {
    const modal = document.getElementById('ClaimModal');
    if (name) document.getElementById('ModalPartnerName').innerText = name;
    if (offer) document.getElementById('ModalPartnerOffer').innerText = offer;
    if (modal) {
      modal.classList.add('is-open');
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }
  }

  function closeClaimModal() {
    const modal = document.getElementById('ClaimModal');
    if (modal) {
      modal.classList.remove('is-open');
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }
  }

  function confirmDiscountClaimed() {
    alert('🎉 Discount Verified & Applied! Thank you for using Tokiyo Membership.');
    closeClaimModal();
  }
</script>

{% schema %}
{
  "name": "Tokiyo Near You",
  "tag": "section",
  "class": "section-tokiyo-near-you"
}
{% endschema %}
